@model WebEcommerce.Models.ProductCategoryViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<main class="container mt-4">


    <div class="title-conteiner">
        <h1>
            Gestione Prodotti
        </h1>
    </div>


    <!--  FILTRI -->
    <div class="mb-4 p-4 bg-white card-animated card-detail">
        <h5 class="mb-4 fw-semibold text-dark">Ricerca Categoria prodotti</h5>
        <div>
            <div class="card-body row g-3" id="filtriContainer">

                <div class="col-md-3">
                    <input type="text" id="searchProductName" name="ProductName" placeholder="Nome Prodotto" class="form-control input-animated" />
                </div>

                <div class="col-md-3">
                    <input type="number" step="0.5" id="searchBasedUnitPriceDa" name="BasedUnitPrice" placeholder="Cerca per Prezzo €" class="form-control input-animated" />
                    <label class="temp-place" for="searchBasedUnitPrice">Da</label>
                </div>

                <div class="col-md-3">
                    <input type="number" step="0.5" id="searchBasedUnitPriceA" name="BasedUnitPrice" placeholder="Cerca per Prezzo €" class="form-control input-animated" />
                    <label class="temp-place" for="searchBasedUnitPrice">A</label>
                </div>

                <div class="col-md-3">
                    <select name="IsDiscontinued" id="searchIsDiscontinued" class="form-select input-animated">
                        <option value="">--Selezionare lo Stato--</option>
                        <option value="false">In Produzione</option>
                        <option value="true">Fuori Produzione</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="CategoryId" id="searchCategoryId" class="form-select input-animated">
                        <option value="">--Selezionare la Categoria--</option>
                        @foreach (var category in Model.ListProductCategories)
                        {
                            <option value="@category.Id">@category.CategoryName</option>
                        }
                    </select>
                </div>



                <div class="col-md-3">
                    <select name="SupplierId" id="searchSupplierId" class="form-select input-animated">
                        <option value="">--Selezionare Fornitore--</option>
                        @foreach (var supplier in Model.TheSupplierList)
                        {
                            <option value="@supplier.Id">@supplier.CompanyName</option>
                        }
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-center gap-2 justify-content-end">
                    <button type="button" id="btnPulisci" class="btn fw-semibold px-4 btn-animated bt-pulisci"><i class="bi-eraser"></i>  Pulisci</button>
                    <button type="button" id="btnCerca" class="btn fw-semibold px-4 btn-animated bt-cerca" data-search-url="@Url.Action("SearchProductsPartial", "GestProductFile")"><i class="bi bi-search me-1"></i> Cerca</button>
                </div>

            </div>
        </div>
    </div>

    <!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------->
    @*TASTO AGGIUNGI*@
    <div class="d-flex justify-content-between align-items-end mb-3">
        <h3 class="m-0">Lista Prodotti</h3>

        <a id="btnAggiungi" class="btn fw-semibold px-4 btn-animated buttonAdd" data-bs-toggle="modal" data-bs-target="#aggiungi">
            <i class="bi-box-fill "></i> Aggiungi
        </a>

    </div>

    <!--========== TABELLA ================-->

    <div id="tabellaContainer">
        @Html.Partial("_ProductsTable", Model)
    </div>

</main>


<!--=============================================================================================================================================================================
    MODALE AGGIUNGI
================================================================================================================================================================================-->
<div class="modal" id="aggiungi" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Aggiungi Prodotto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="mb-4 p-4 bg-white card-animated card-detail">
                    <div>
                        <div class="card-body row g-3">

                            <form id="ProductForm">

                                <div class="col-md-6">

                                    <div class="mb-3">
                                        <label for="addProductName">Nome Prodotto*</label>
                                        <input type="text" id="addProductName" name="ProductName" placeholder="Nome Prodotto" class="form-control input-animated" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="addPackage">Confezione</label>
                                        <input type="text" id="addPackage" name="Package" placeholder="Es. Scatola da 100" class="form-control input-animated" />
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="mb-3">
                                        <label for="add-SupplierId">Fornitore*</label>
                                        <select name="SupplierId" id="addSupplierId" class="form-select" required>
                                            <option value="">--Selezionare il fornitore--</option>
                                            @if (Model.TheSupplierList != null)
                                            {
                                                foreach (var supplier in Model.TheSupList)
                                                {
                                                    <option value="@supplier.Id">@supplier.CompanyName</option>
                                                }
                                            }

                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label for="addCategoryId">Categorie*</label>
                                        <select name="CategoryId" id="addCategoryId" class="form-select" required>
                                            <option value="">--Selezionare la categoria del prodotto--</option>
                                            @if (Model.ListProductCategories != null)
                                            {
                                                foreach (var category in Model.ListProductCategories)
                                                {
                                                    <option value="@category.Id">@category.CategoryName</option>
                                                }
                                            }

                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label for="addBasedUnitPrice">Prezzo Base (€)</label>
                                        <input type="number" step="0.01" id="addBasedUnitPrice" name="BasedUnitPrice" placeholder="Prezzo in €" class="form-control input-animated" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="d-block">Stato Produzione</label>
                                        <div class="form-check form-check-inline">
                                            <input type="radio" id="addIsDiscontinued" name="IsDiscontinued" value="false" class="form-check-input" checked />
                                            <label class="form-check-label" for="addIsDiscontinued">In Produzione</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input type="radio" id="addIsDiscontinued" name="IsDiscontinued" value="true" class="form-check-input" />
                                            <label class="form-check-label" for="addIsDiscontinued">Fuori Produzione</label>
                                        </div>
                                    </div>

                                    <div class="form-check mb-3">
                                        <input type="checkbox" id="addVisibleInHP" class="form-check-input" />
                                        <label class="form-check-label" for="addVisibleInHP">Visibile in Homepage</label>
                                    </div>

                                </div>
                            </form>

                        </div>
                    </div>
                </div>

                <div id="resultMessage" class="mt-2 text-center"></div>

            </div>

            <div class="modal-footer buttons">
                <button type="button" class="no-btn" data-bs-dismiss="modal">Indietro</button>
                <button type="button" id="btnSalvaProdotto" class="si-edit-btn">Salva</button>
            </div>

        </div>
    </div>
</div>

<!--=================================================================================================================================
    MODALE ELIMINA
==================================================================================================================================-->

<div class="myModal-overlay" id="modalElimina">
    <div class="personal-card">
        <div class="body">

            <!--risultato messaggio errore o successo-->
            <div id="resultMessageDel"></div>

            <div class="cont-icon">
                <span class="icona-attenzione"></span>
            </div>


            <h3>Conferma eliminazione</h3>
            <p>Sei sicuro di voler cancellare questo prodotto"<strong id="ProdottoDaCancellare"></strong>"?</p>

        </div>
        <div class="buttons">
            <button class="no-btn">No, Annulla</button>
            <button id="delList-btn" class="si-btn" data-delete-url="@Url.Action("Delete", "GestProductFile")">Si, Cancella</button>
        </div>
    </div>
</div>


<!--=======================================================================================================================================
    MODALE MODIFICA PRODOTTO
===========================================================================================================================================-->
<div class="modal fade" id="modalEdit" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Modifica Prodotto</h5>
                <button type="button" class="btn-close" aria-label="Close" data-bs-dismiss="modal"></button>
            </div>

            <div class="mb-4 p-4 bg-white card-animated card-detail">
                <div class="card-body row g-3">
                    <!-- ID Nascosto per la modifica -->
                    <input type="hidden" id="editId" />

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editProductName">Nome Prodotto</label>
                            <input type="text" id="editProductName" name="ProductName" placeholder="Nome Prodotto" class="form-control input-animated" required />
                        </div>

                        <div class="mb-3">
                            <label for="editSupplierId">Fornitore</label>
                            <select id="editSupplierId" name="SupplierId" class="form-select input-animated" required>
                                <option value="">-- Seleziona Fornitore --</option>
                                @if (Model.TheSupList != null)
                                {
                                    foreach (var supplier in Model.TheSupList)
                                    {
                                        <option value="@supplier.Id">@supplier.CompanyName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="editCategoryId">Categoria</label>
                            <select id="editCategoryId" name="CategoryId" class="form-select input-animated" required>
                                <option value="">-- Seleziona Categoria --</option>
                                @if (Model.ListProductCategories != null)
                                {
                                    foreach (var category in Model.ListProductCategories)
                                    {
                                        <option value="@category.Id">@category.CategoryName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="editBasedUnitPrice">Prezzo Unitario Base (€)</label>
                            <input type="number" step="0.01" id="editBasedUnitPrice" name="BasedUnitPrice" placeholder="0.00" class="form-control input-animated" required />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editPackage">Confezione / Imballo</label>
                            <input type="text" id="editPackage" name="Package" placeholder="es. 12 bottiglie" class="form-control input-animated" />
                        </div>

                        <div class="mb-3">
                            <label for="editIsDiscontinued">Stato Prodotto</label>
                            <select id="editIsDiscontinued" name="IsDiscontinued" class="form-select input-animated">
                                <option value="false">In Produzione / Attivo</option>
                                <option value="true">Fuori Produzione / Discontinuato</option>
                            </select>
                        </div>

                        <div class="mb-3 form-check mt-4">
                            <input type="checkbox" id="editVisibleInHP" name="VisibleInHP" class="form-check-input" />
                            <label class="form-check-label" for="editVisibleInHP">Visibile in Homepage</label>
                        </div>
                    </div>

                </div>
            </div>

            <div id="resultMessageEdit" class="error-message"></div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary simpleBevel" data-bs-dismiss="modal">Annulla</button>
                <button type="button" id="btnEditModifica" class="btn btn-success simpleBevel">Salva Modifiche</button>
            </div>
        </div>
    </div>
</div>



@section scripts {
    <script src="@Url.Content("~/Scripts/js/Product.js")"></script>
}


