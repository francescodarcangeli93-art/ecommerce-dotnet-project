@model WebEcommerce.Models.ProductCategoryViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<main class="container mt-4">


    <div class="title-conteiner">
        <h1>
            Gestione Prodotti
        </h1>
    </div>


    <!--  FILTRI -->
    <div class="mb-4 p-4 bg-white card-animated card-detail">
        <h5 class="mb-4 fw-semibold text-dark">Ricerca Categoria prodotti</h5>
        <div>
            <div class="card-body row g-3" id="filtriContainer">

                <div class="col-md-3">
                    <input type="text" id="searchProductName" name="ProductName" placeholder="Nome Prodotto" class="form-control input-animated" />
                </div>

                <div class="col-md-3">
                    <input type="number" step="0.5" id="searchBasedUnitPriceDa" name="BasedUnitPrice" placeholder="Cerca per Prezzo €" class="form-control input-animated" />
                    <label class="temp-place" for="searchBasedUnitPrice">Da</label>
                </div>

                <div class="col-md-3">
                    <input type="number" step="0.5" id="searchBasedUnitPriceA" name="BasedUnitPrice" placeholder="Cerca per Prezzo €" class="form-control input-animated" />
                    <label class="temp-place" for="searchBasedUnitPrice">A</label>
                </div>

                <div class="col-md-3">
                    <select name="IsDiscontinued" id="searchIsDiscontinued" class="form-select input-animated">
                        <option value="">--Selezionare lo Stato--</option>
                        <option value="false">In Produzione</option>
                        <option value="true">Fuori Produzione</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="CategoryId" id="searchCategoryId" class="form-select input-animated">
                        <option value="">--Selezionare la Categoria--</option>
                        @foreach (var category in Model.ListProductCategories)
                        {
                            <option value="@category.Id">@category.CategoryName</option>
                        }
                    </select>
                </div>

                

                <div class="col-md-3">
                    <select name="CategoryId" id="searchCategoryId" class="form-select input-animated">
                        <option value="">--Selezionare Fornitore--</option>
                        @foreach (var supplier in Model.TheSupplierList)
                        {
                            <option value="@supplier.Id">@supplier.CompanyName</option>
                        }
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-center gap-2 justify-content-end">
                    <button type="button" id="btnPulisci" class="btn fw-semibold px-4 btn-animated bt-pulisci"><i class="bi-eraser"></i>  Pulisci</button>
                    <button type="button" id="btnCerca" class="btn fw-semibold px-4 btn-animated bt-cerca" data-search-url="@Url.Action("SearchProductsPartial", "GestProductFile")"><i class="bi bi-search me-1"></i> Cerca</button>
                </div>

            </div>
        </div>
    </div>

    <!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------->

    @*TASTO AGGIUNGI*@
    <div class="d-flex justify-content-between align-items-end mb-3">
        <h3 class="m-0">Lista Fornitori</h3>

        <a id="btnAggiungi" class="btn fw-semibold px-4 btn-animated buttonAdd">
            <i class="bi-box-fill "></i> Aggiungi
        </a>

    </div>

    <!--========== TABELLA ================-->

    <div id="tabellaContainer">
        @Html.Partial("_ProductsTable", Model)
    </div>

</main>


@section scripts {
    <script src="@Url.Content("~/Scripts/js/ProductFiles.js")"></script>
}