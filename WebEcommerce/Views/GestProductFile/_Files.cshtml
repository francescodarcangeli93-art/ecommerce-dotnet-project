@model WebEcommerce.Models.ProductCategoryViewModel

<div class="table-responsive bevel">

    <input type="hidden" id="idFileDaEliminare" value="" />

    <table class="table table-striped table-hover table-bordered align-middle mb-0 tab-fix">
        <thead class="table-dark table-bordered text-nowrap">
            <tr>
                <th scope="col" class="text-center">Titolo / Nome File</th>
                <th scope="col" class="text-center">Dimensione</th>
                <th scope="col" class="text-center">Principale</th>
                <th scope="col" class="text-center">STATO</th>
                <th class="text-center px-4">COMANDI</th>
            </tr>
        </thead>
        <tbody id="corpoTabellaFile">
            @if (Model != null && Model.GetManualsList != null && Model.GetManualsList.Any())
            {
                foreach (var file in Model.GetManualsList)
                {
                    <tr data-id="@file.Id">

                        <!-- NOME FILE E TITOLO -->
                        <td class="text-start">

                            <i class="bi bi-file-earmark-pdf-fill text-danger me-2 fs-5"></i>

                            <strong class="text-truncate">@(string.IsNullOrEmpty(file.Title) ? file.FileName : file.Title)</strong>

                            @if (!string.IsNullOrEmpty(file.Title) && file.Title != file.FileName)
                            {
                                <br /><small class="d-block text-muted text-truncate" title="@(file.FileName)">@file.FileName</small>
                            }
                        </td>

                        <!-- DIMENSIONE KB -->
                        <td class="text-center text-nowrap">
                            @if (file.FileSizeKb >= 1024 * 1024)
                            {
                                @($"{(file.FileSizeKb / (1024.0 * 1024.0)):0.#} GB")
                            }
                            else if (file.FileSizeKb >= 1024)
                            {
                                @($"{(file.FileSizeKb / 1024.0):0.#} MB")
                            }
                            else
                            {
                                @($"{file.FileSizeKb} KB")
                            }

                        </td>

                        <!-- FILE PRINCIPALE -->
                        <td class="text-center text-nowrap">
                            @if (file.IsMain)
                            {
                                <i class="bi bi-star-fill text-warning fs-5" title="File Principale"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-muted opacity-25" title="Non principale"></i>
                            }
                        </td>

                        <!-- GESTIONE ATTIVO / NON ATTIVO -->
                        <td class="text-center text-nowrap">
                            <button type="button"
                                    class="btn btn-sm fw-bold text-uppercase d-inline-flex align-items-center justify-content-center border-2 attivo
                                    @(file.IsActive ? "btn-outline-success text-success bg-success bg-opacity-10" : "btn-outline-danger text-danger bg-danger bg-opacity-10")">
                                @(file.IsActive ? "Attivo" : "Inattivo")
                            </button>
                        </td>

                        <!-- COMANDI -->
                        <td class="px-4 spazio-comandi text-center text-nowrap">
                            <!-- DOWNLOAD / APRI FILE -->
                            <a href="@Url.Action("DownloadProductDocument", "GestProductFile", new { id = file.Id })"
                               class="btn btn-sm btn-outline-info py-1 simpleBevel btn-scarica"
                               title="Scarica / Apri File">
                                <i class="bi bi-download"></i>
                            </a>

                            <!-- ELIMINA FILE -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger py-1 simpleBevel btn-elimina-file"
                                    title="Cancella File"
                                    data-id="@file.Id"
                                    data-name="@file.FileName">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted fw-bold">
                        <i class="bi bi-folder-x fs-3 d-block mb-1"></i>
                        Nessun manuale o file PDF caricato.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

