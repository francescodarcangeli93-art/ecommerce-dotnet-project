@model WebEcommerce.Models.ProductCategoryViewModel
<div class="images-conteiner">

    <img id="mainProductImage" class="primary-image" src="@Url.Action("GetProductFileContent", "GestProductFile", new { id = Model.MainImage.Id })" alt="@(Model.MainImage.Description)" />


    <ul class="list-images">
        @foreach (var image in Model.GetProductFileByIdList)
        {
            <li>
                <img class="product-img"
                     src="@Url.Action("GetProductFileContent", "GestProductFile", new { id = image.Id })" 
                     data-full-src="@Url.Action("GetProductFileContent", "GestProductFile", new { id = image.Id })"
                     alt="@(image.Description)"/>
            </li>
        }

    </ul>
</div>