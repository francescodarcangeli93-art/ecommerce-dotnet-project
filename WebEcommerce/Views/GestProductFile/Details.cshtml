@model WebEcommerce.Models.ProductCategoryViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}
<main class="container mt-4">

    <h1 class="fw-bold mb-4 details-page-title">
        Dettagli Prodotto
    </h1>



    <div class="d-flex justify-content-between align-items-end mb-3">
        <h5 class="m-0">Immagini e Documenti</h5>

        <button type="button" id="btnAggiungiFile" class="btn fw-semibold px-4 btn-animated buttonAdd" data-bs-toggle="modal" data-bs-target="#modalAggiungiFile">
            <i class="bi bi-image-fill me-1"></i> Aggiungi Immagine/File
        </button>
    </div>


    <div class="section-conteiner">

        <!-- PARTIAL VIEW IMMAGGINI-->

        <div id="imagesList">

            @Html.Partial("_Images", Model)
        </div>

<!------------------------------------------------------------------------------------------------------------------------------------------------------->

        <div class="details-conteiner">
            <h3>@Model.TheProduct.ProductName</h3>
            <hr />
        
            <span><strong> Fornitore:</strong>  @Model.TheProduct.CompanyName</span>
            <span><strong>Prezzo:</strong>  @Model.TheProduct.BasedUnitPrice</span>
            <span> <strong>Package:</strong> @Model.TheProduct.Package</span>
            <span><strong>Stato:</strong> @Model.TheProduct.IsDiscontinued</span>
        

        </div>
    </div>
    <hr />
    <div class="file-conteiner">
        <h3>lista file</h3>
    </div>
    <div class="d-flex justify-content-start align-items-center mt-4">
        <a href="javascript:history.back();" class="btn btn-animated fw-semibold px-4 btn-details-back">
            ← Indietro
        </a>
    </div>

</main>


<!--===========================================================================================================================
   1 MODALE AGGIUNGI PRODOTTO
  ==========================================================================================================================-->

<div class="modal" id="modalAggiungiFile" tabindex="-1" data-bs-backdrop="static" data-bs-focus="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Aggiungi Immagine/File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <form id="formAggiungiFile">

                    <div class="mb-3">
                        <label for="uploadFile" class="">Seleziona File*</label>
                        <input type="file" id="uploadFiles" accept="image/*,.pdf" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label for="uploadTitle" class="">Titolo Immagine*</label>
                        <input type="text" id="uploadTitle" accept="image/*,.pdf" class="form-control" required />
                    </div>

                    <div class="form-check mb-3">
                        <input type="checkbox" id="uploadIsMain" class="form-check-input" />
                        <label class="form-check-label" for="uploadIsMain">Immagine principale</label>
                    </div>

                    <div class="mb-3">
                        <label for="uploadDescription" class="form-label">Descrizione</label>
                        <textarea  id="uploadDescription" class="form-control" rows="5" cols="33"></textarea>
                    </div>

                </form>

                <div id="resultMessageUpload" class="mt-2"></div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" id="btnUploadFile" class="btn btn-primary" data-product-id="@Model.TheProduct.ProductId">Carica</button>
            </div>

        </div>
    </div>
</div>


<!--=================================================================================================================================================================
   2 MODALE DETTAGLIO IMMAGINE
  ===================================================================================================================================================================-->

<div class="myModal-overlay" id="modalShowImageDetail">
    <div class="personal-card image-cardColor dimension-card personal-card-radius bodyImage-grid">

        <div class="title-image">
            <h2>Dettaglio <span id="ImageTitle"></span></h2>
            <button class="mybtn-close" type="button">&times;</button>
            <hr />
        </div>

        <div class="Image-picture">
          
            <img id="modalImage" src="" alt="Immagine Ingrandita" />

        </div>
        <div class="image-detail">

            <div class="description-conteiner">
                <p id="Detail-Description" class="description-text"></p>
               
            </div>
            

            <div class="info-product">
                <p><strong>File:</strong> <span id="Detail-FileType"></span></p>
                <p><strong>Nome file:</strong> <span id="Detail-FileName"></span></p>
                <p><strong>Dimensioni file in byte:</strong>  <span id="Detail-FileSizeKb"></span></p>
                <p><strong>Data creazione:</strong>   <span id="Detail-CreatedDate"></span></p>
                <p><strong>Stato:</strong>  <span id="Detail-IsActive"></span></p>
                <p> Immagine <span id="Detail-IsMain"></span></p>
            </div>
            <hr />

            <div id="ModalSmallImageConteiner" class="Modal-smallImage-conteiner"></div>
        </div>

    </div>
</div>


@section scripts {
    <script src="@Url.Content("~/Scripts/js/ProductFiles.js")"></script>
}