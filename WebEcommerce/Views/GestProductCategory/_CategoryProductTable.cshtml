@model WebEcommerce.Models.ProductCategoryViewModel

<div class="table-responsive bevel">

    <input type="hidden" id="CategoriaDaEliminare" value="" />

    <table class="table table-striped table-hover table-bordered align-middle mb-0 tab-fix">
        <thead class="table-dark table-bordered">
            <tr>
               
                <th scope="col" class="text-center">Nome</th>
                <th scope="col" class="text-center">Descrizione</th>
                <th scope="col" class="text-center col-shrink-15">STATO</th>
                <th scope="col" class="text-center col-shrink-10">Prodotti</th>
                <th scope="col" class="text-center px-4 col-shrink-12">COMANDI</th>
            </tr>
        </thead>
        <tbody id="corpoTabella">
          @foreach(var prCategory in Model.TheProductCategory)
            {
                <tr data-id="@prCategory.Id">
                    <td class="text-start">@prCategory.Name</td>
                    <td class="text-start">@prCategory.Description</td>
             
            
                    <!-- GESTIONE ATTIVO NON ATTIVO -->
                    <td class="text-center">
                        <button type="submit"
                    
                            class="btn btn-sm fw-bold text-uppercase d-inline-flex align-items-center justify-content-center border-2 attivo
                            @(prCategory.IsActive ? "btn-outline-success text-success bg-success bg-opacity-10" : "btn-outline-danger text-danger bg-danger bg-opacity-10")">
                            @(prCategory.IsActive ? "Attivo" : "Non Attivo")
                        </button>         
                    </td>
                    <!--  PRODOTTI -->
                    <td class="text-center">
                        <div  class="@prCategory.IsNoProduct">
                            <button class="filtro-categoria" data-filtro="@prCategory.Id" data-filtri-url="@Url.Action("index", "GestProductFile")" title="tot=@prCategory.ProductAmount"><i class="bi bi-box-fill"></i></button>
                        </div>
                    </td>

                    <td class="text-center px-4 spazio-comandi">
                        @*<a href="@Url.Action("Details","GestProductCategory", new {id = prCategory.Id})" class="btn btn-sm btn-outline-info py-1 simpleBevel btn-dettagli" data-id="@prCategory.Id" title="Visualizza Dettagli">
                            <i class="bi bi-search"></i>
                        </a>*@

                        <a class="btn btn-sm btn-outline-warning py-1 simpleBevel btn-modifica" data-id="@prCategory.Id" data-name="@prCategory.Name" 
                           data-load-url="@Url.Action("Edit", "GestProductCategory")"
                           title="Modifica riga">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <!-- ELIMINA CATEGORIA -->
                        <button type="button"
                                class="btn btn-sm btn-outline-danger py-1 simpleBevel btn-elimina"
                               
                                title="Cancella categoria"
                                data-id="@prCategory.Id"
                                data-name="@prCategory.Name">

                            <i class="bi bi-trash"></i>
                        </button>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
