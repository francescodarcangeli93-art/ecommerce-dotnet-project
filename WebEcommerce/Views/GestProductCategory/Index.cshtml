@model WebEcommerce.Models.ProductCategoryViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}
<main class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="fw-bold text-black text-center w-100 titolo-animated">
            Gestione Categorie Prodotti
        </h1>
    </div>


    <!--  FILTRI -->
    <div class="mb-4 p-4 bg-white card-animated card-detail">
        <h5 class="mb-4 fw-semibold text-dark">Ricerca Categoria prodotti</h5>
        <div>
            <div class="card-body row g-3" id="filtriContainer">

                <div class="col-md-3">
                    <input type="text" id="searchNome" name="Name" placeholder="Nome Categoria" class="form-control input-animated" />
                </div>

                <div class="col-md-3">
                    <select name="IsActive" id="searchIsActive" class="form-select input-animated">
                        <option value="">--Selezionare lo Stato--</option>
                        <option value="true">Attivo</option>
                        <option value="false">Non Attivo</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <input type="text" id="searchNome" name="Name" placeholder="Descizione" class="form-control input-animated" />
                </div>

                <div class="col-md-3 d-flex align-items-center gap-2 justify-content-end">
                    <button type="button" id="btnPulisci" class="btn fw-semibold px-4 btn-animated bt-pulisci"><i class="bi-eraser"></i>  Pulisci</button>
                    <button type="button" id="btnCerca" class="btn fw-semibold px-4 btn-animated bt-cerca"><i class="bi bi-search me-1"></i> Cerca</button>
                </div>

            </div>
        </div>
    </div>


    @*TASTO AGGIUNGI*@
    <div class="d-flex justify-content-between align-items-end mb-3">
        <h3 class="m-0">Lista Categorie </h3>

        <a id="btnAggiungi" class="btn fw-semibold px-4 btn-animated buttonAdd" data-bs-toggle="modal" data-bs-target="#aggiungi">
            <i class="bi bi-box-seam"></i> Aggiungi
        </a>
    </div>


    <!--========== TABELLA ================-->

    <div id="tabellaContainer">
        @Html.Partial("_CategoryProductTable", Model)
    </div>

</main>




@section scripts {
    <script src="@Url.Content("~/Scripts/js/GestioneWarehouse.js")"></script>
}