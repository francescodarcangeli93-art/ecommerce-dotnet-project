@model WebEcommerce.Models.PriceListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}


<main class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="fw-bold text-black text-center w-100 titolo-animated">
            Gestione Listini
        </h1>
    </div>

    <!--  FILTRI -->
    <div class="mb-4 p-4 bg-white card-animated card-detail">
        <h5 class="mb-4 fw-semibold text-dark">Ricerca Listino</h5>
        <div>
            <div class="card-body row g-3" id="filtriContainer">

                <div class="col-md-3">
                    <input type="text" id="searchPriceListName" name="PriceListName" placeholder="Nome Listino" class="form-control input-animated" />
                </div>

                <div class="col-md-3">
                    <input type="text" id="searchDescription" name="Description" placeholder="Descrizione" class="form-control input-animated" />
                </div>

                <div class="col-md-3">
                    <input type="date" id="searchStartDate" name="StartDate" placeholder="Data Inizio" class="form-control input-animated" />
                    <label for="searchStartDate" class="temp-place">Data Inizio</label>
                </div>

                <div class="col-md-3">
                    <input type="date" id="searchEndDate" name="EndDate" placeholder="Data Fine" class="form-control input-animated" />
                    <label for="searchEndDate" class="temp-place">Data Fine</label>
                </div>

                <div class="col-md-3">
                    <select name="CurrencyCode" id="searchCurrencyCode" class="form-select input-animated is-placeholder">
                        <option value="">--Selezionare la Valuta--</option>
                        <option value="EUR">EUR</option>
                        <option value="USD">USD</option>
                        <option value="GBP">GBP</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="IsDefault" id="searchIsDefault" class="form-select input-animated is-placeholder">
                        <option value="">--Selezionare Default--</option>
                        <option value="true">Default</option>
                        <option value="false">Non Default</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="IsActive" id="searchIsActive" class="form-select input-animated is-placeholder">
                        <option value="">--Selezionare lo Stato--</option>
                        <option value="true">Attivo</option>
                        <option value="false">Non Attivo</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-center gap-2 justify-content-end">
                    <button type="button" id="btnPulisci" class="btn fw-semibold px-4 btn-animated bt-pulisci"><i class="bi-eraser"></i>  Pulisci</button>
                    <button type="button" id="btnCerca" data-search-url="@Url.Action("SearchPriceListPartial", "GestPriceList")" class="btn fw-semibold px-4 btn-animated bt-cerca"> <i class="bi bi-search me-1"></i> Cerca</button>
                </div>

            </div>

        </div>


    </div>

    @*TASTO AGGIUNGI*@
    <div class="d-flex justify-content-between align-items-end mb-3">
        <h3 class="m-0">Listino Prezzi</h3>

        <a id="btnAggiungi" class="btn fw-semibold px-4 btn-animated buttonAdd" data-bs-toggle="modal" data-bs-target="#aggiungi">
            <i class="bi bi-tag-fill"></i>  Aggiungi
        </a>
    </div>

    <!-- Tabella Listino Prezzi -->
    <div id="tabellaContainer">
        @Html.Partial("_PriceListTable", Model)
    </div>


    <!-- Modale Elimina  -->
    <div class="myModal-overlay" id="modalElimina">
        <div class="personal-card">
            <div class="body">

                <!--risultato messaggio errore o successo-->
                <div id="resultMessageDel"></div>

                <div class="cont-icon">
                    <span class="icona-attenzione"></span>
                </div>


                <h3>Conferma eliminazione</h3>
                <p>Sei sicuro di voler eliminare l'indirizzo "<strong id="delPriceList"></strong>"?</p>
            </div>
            <div class="buttons">
                <button class="no-btn">No, Annulla</button>
                <button id="delList-btn" class="si-btn" data-delete-url="@Url.Action("Delete", "GestPriceList")">Si, Cancella</button>
            </div>
        </div>
    </div>



    <!--MODALE AGGIUNGI-->
    <div class="modal fade" id="aggiungi" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">Aggiungi un nuovo <strong>Listino Prezzi</strong></h5>

                </div>
                <div class="modal-body">

                    <div class="mb-4 p-4 bg-white card-animated card-detail">
                        <div>
                            <form id="priceListForm">

                                <div class="card-body row g-3">

                                    <div class="col-md-6">
                                        <input type="text" id="addPriceListName" name="PriceListName" placeholder="Nome Listino*" class="form-control input-animated" required />
                                    </div>

                                    <div class="col-md-6">
                                        <input type="text" id="addDescription" name="Description" placeholder="Descrizione" class="form-control input-animated" />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="addStartDate">Data Inizio</label>
                                        <input type="date" id="addStartDate" name="StartDate" placeholder="Data Inizio*" class="form-control input-animated" required />

                                    </div>

                                    <div class="col-md-6">
                                        <label for="addEndDate">Data Fine</label>
                                        <input type="date" id="addEndDate" name="EndDate" placeholder="Data Fine" class="form-control input-animated" />

                                    </div>

                                    <div class="col-md-6">
                                        <select name="CurrencyCode" id="addCurrencyCode" class="form-select input-animated is-placeholder" required>
                                            <option value="">--Selezionare la Valuta--</option>
                                            <option value="EUR">EUR</option>
                                            <option value="USD">USD</option>
                                            <option value="GBP">GBP</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <select name="IsDefault" id="addIsDefault" class="form-select input-animated is-placeholder" required>
                                            <option value="">--Selezionare Default--</option>
                                            <option value="true">Default</option>
                                            <option value="false">Non Default</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <select name="IsActive" id="addIsActive" class="form-select input-animated is-placeholder" required>
                                            <option value="">--Selezionare lo Stato--</option>
                                            <option value="true">Attivo</option>
                                            <option value="false">Non Attivo</option>
                                        </select>
                                    </div>

                                </div>
                            </form>

                        </div>
                    </div>

                    <div id="resultMessage" class="mt-2 text-center"></div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary simpleBevel" data-bs-dismiss="modal" data-dismiss="modal">Indietro</button>
                    <button type="button" id="btnSalva" class="btn btn-primary simpleBevel" data-save-url="@Url.Action("Save", "GestPriceList")">Salva</button>
                </div>

            </div>
        </div>
    </div>

    <!--MODALE Modifica-->
    <div class="modal fade" id="modalEdit" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Modifica Listino</h5>
                    <button type="button" class="btn-close"  aria-label="Close"></button>
                </div>

                <div class="mb-4 p-4 bg-white card-animated card-detail">
                    <div>
                        <div class="card-body row g-3">
                            <input type="hidden" id="editId" />

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editPriceListName">Nome Listino</label>
                                    <input type="text" id="editPriceListName" name="PriceListName" placeholder="Nome Listino" class="form-control input-animated" required />
                                </div>

                                <div class="mb-3">
                                    <label for="editDescription">Descrizione</label>
                                    <input type="text" id="editDescription" name="Description" placeholder="Descrizione" class="form-control input-animated" required />
                                </div>

                                <div class="mb-3">
                                    <label for="editStartDate">Data Inizio</label>
                                    <input type="date" id="editStartDate" name="StartDate" class="form-control input-animated" required />
                                </div>

                                <div class="mb-3">
                                    <label for="editEndDate">Data Fine</label>
                                    <input type="date" id="editEndDate" name="EndDate" class="form-control input-animated" required />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editCurrencyCode">Valuta</label>
                                    <select name="CurrencyCode" id="editCurrencyCode" class="form-select input-animated" required>
                                        <option value="">--Selezionare la Valuta--</option>
                                        <option value="EUR">EUR</option>
                                        <option value="USD">USD</option>
                                        <option value="GBP">GBP</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label>Default</label><br />
                                    <label class="me-2">
                                        <input type="radio" id="editIsDefaultTrue" name="editIsDefault" value="true" />
                                        <span>Default</span>
                                    </label>
                                    <label>
                                        <input type="radio" id="editIsDefaultFalse" name="editIsDefault" value="false" checked />
                                        <span>Non Default</span>
                                    </label>
                                </div>

                                <div class="mb-3">
                                    <label>Stato</label><br />
                                    <label class="me-2">
                                        <input type="radio" id="editTrue" name="editIsActive" value="true" checked />
                                        <span>Attivo</span>
                                    </label>
                                    <label>
                                        <input type="radio" id="editFalse" name="editIsActive" value="false" />
                                        <span>Non Attivo</span>
                                    </label>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div id="resultMessageListino" class="error-message"></div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                    <button type="button" id="btnEditModifica" class="btn btn-success">Modifica</button>
                </div>
            </div>
        </div>
    </div>


</main>

<div id="modalContainer"></div>

@section scripts {
    <script src="@Url.Content("~/Scripts/js/GestionePriceList.js")"></script>
    <script src="@Url.Content("~/Scripts/js/GestionePriceListItem.js")"></script>
}
