@{
    ViewBag.Title = "Home Page";
    string saluto = DateTime.Now.Hour < 12 ? "Buongiorno" : DateTime.Now.Hour < 18 ? "Buon pomeriggio" : "Buonasera";
    string ruolo = Session["Role"]?.ToString().ToLower();
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}

<main class="container-fluid px-4 mt-4">

    <h1 class="fw-bold mb-1" style="font-size: 2rem;">
        @saluto, <span style="color: #ffc107;">@Session["User"]</span>!
    </h1>
    <p class="text-muted mb-4">
        <i class="bi bi-calendar me-1"></i> @DateTime.Now.ToString("dddd, dd MMMM yyyy")
    </p>

    @if (ruolo == "admin" || ruolo == "admin-customer")
    {
        <div class="row g-3 mb-5">

            <div class="col-md-3 card-fadein">
                <div class="p-4 bg-white card-animated home-stat-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <p class="text-muted mb-1" style="font-size: 0.85rem;">Totale Utenti</p>
                            <h3 class="fw-bold mb-0">--</h3>
                        </div>
                        <i class="bi bi-people-fill icon-stat-yellow"></i>
                    </div>
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill fill-70"></div>
                    </div>
                    <p class="text-muted mt-1 mb-0" style="font-size: 0.75rem;">70% rispetto al mese scorso</p>
                </div>
            </div>

            <div class="col-md-3 card-fadein">
                <div class="p-4 bg-white card-animated home-stat-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <p class="text-muted mb-1" style="font-size: 0.85rem;">Totale Ordini</p>
                            <h3 class="fw-bold mb-0">--</h3>
                        </div>
                        <i class="bi bi-bag-fill icon-stat-dark"></i>
                    </div>
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill fill-50"></div>
                    </div>
                    <p class="text-muted mt-1 mb-0" style="font-size: 0.75rem;">50% rispetto al mese scorso</p>
                </div>
            </div>

            <div class="col-md-3 card-fadein">
                <div class="p-4 bg-white card-animated home-stat-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <p class="text-muted mb-1" style="font-size: 0.85rem;">Totale Prodotti</p>
                            <h3 class="fw-bold mb-0">--</h3>
                        </div>
                        <i class="bi bi-box-seam-fill icon-stat-yellow"></i>
                    </div>
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill fill-85"></div>
                    </div>
                    <p class="text-muted mt-1 mb-0" style="font-size: 0.75rem;">85% rispetto al mese scorso</p>
                </div>
            </div>

            <div class="col-md-3 card-fadein">
                <div class="p-4 bg-white card-animated home-stat-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <p class="text-muted mb-1" style="font-size: 0.85rem;">Totale Clienti</p>
                            <h3 class="fw-bold mb-0">--</h3>
                        </div>
                        <i class="bi bi-person-fill icon-stat-dark"></i>
                    </div>
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill fill-60"></div>
                    </div>
                    <p class="text-muted mt-1 mb-0" style="font-size: 0.75rem;">60% rispetto al mese scorso</p>
                </div>
            </div>

        </div>
    }

    @if (ruolo == "admin-customer" || ruolo == "customer")
    {
        <h5 class="fw-bold mb-3">I tuoi ultimi ordini</h5>
        <div class="d-flex gap-3 mb-5 overflow-auto pb-2">
            @for (int i = 0; i < 4; i++)
            {
                <div class="bg-white card-animated flex-shrink-0 home-order-card">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-bag-fill" style="color: #ffc107; font-size: 1.5rem;"></i>
                        <span class="fw-semibold">Ordine #000@(i + 1)</span>
                    </div>
                    <p class="text-muted mb-1" style="font-size: 0.8rem;">Data: --/--/----</p>
                    <p class="text-muted mb-0" style="font-size: 0.8rem;">Stato: <span class="badge status-badge-waiting">In attesa</span></p>
                </div>
            }
        </div>

        <h5 class="fw-bold mb-3">Prodotti consigliati per te</h5>
        <div class="row g-3 mb-5">
            @for (int i = 1; i <= 4; i++)
            {
                <div class="col-md-3">
                    <div class="bg-white card-animated home-product-card">
                        <div class="product-img-container">
                            <img src="~/Content/Images/prodotti/prodotto-@(i).png" alt="prodotti" class="img-fluid product-img-style" />
                        </div>

                        <div class="p-3">
                            <h6 class="fw-bold mb-1">Nome Prodotto</h6>
                            <p class="text-muted mb-2" style="font-size: 0.8rem;">Categoria</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold login-link-register">€ --,--</span>
                                <button class="btn btn-sm btn-animated btn-add-cart">
                                    <i class="bi bi-cart-plus me-1"></i> Aggiungi
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</main>