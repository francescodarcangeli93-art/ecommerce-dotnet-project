@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}

<div class="d-flex flex-column align-items-center mt-5">

    <!-- Logo -->
    <div class="text-center mb-3">
        <img src="~/Content/Image/Icon.png" width="180" alt="Logo" />
    </div>

    <!-- Titolo fuori dalla card -->
    <div class="text-center mb-4">
        <h4 class="bentornato"><strong>Bentornato</strong></h4>
        <p class="sottotitolo-login">Accedi al tuo account ECOMMERCE HUB e gestisci il tuo store</p>
    </div>

    <!-- Card -->
    <div class="bg-white p-5 login-card">

        <!-- Errore -->
        @if (ViewData["Errore"] != null)
        {
            <div class="alert alert-danger" style="border-radius: 12px;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewData["Errore"]
            </div>
        }

        <!-- Form -->
    <form action="@Url.Action("Login", "Login")" method="POST">

        <!-- Username -->
        <div class="mb-3">
            <div class="login-input-group">
                <div class="login-input-icon">
                    <i class="bi bi-person"></i>
                </div>
                <input type="text" name="user" placeholder="Inserisci username" required class="login-input-field" />
            </div>
        </div>

        <!-- Password -->
        <div class="mb-4">
            <div class="login-input-group">
                <div class="login-input-icon">
                    <i class="bi bi-lock"></i>
                </div>
                <input type="password" name="password" placeholder="Inserisci password" required class="login-input-field" />
            </div>
        </div>

        <button type="submit" class="btn w-100 fw-bold btn-login-submit">
            <i class="bi bi-box-arrow-in-right me-2"></i> Accedi
        </button>

        <hr />

        <p class="text-center">Non hai ancora un account? <a class="fw-bold login-link-register" href="#">registrati</a></p>

    </form>
    </div>
</div>