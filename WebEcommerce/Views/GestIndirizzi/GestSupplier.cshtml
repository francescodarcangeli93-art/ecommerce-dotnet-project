@model WebEcommerce.Models.GestioneUtentiViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Indirizzi di @Model.UserDetail.FirstName</h3>
<p>email: @Model.UserDetail.Email</p>

<!-- Tasto indirizzi -->

<div class="d-flex justify-content-end align-items-end mb-3">


    <a href="" id="btnAggiungi" class="btn fw-semibold px-4 buttonAdd"
       data-bs-toggle="modal"
       data-bs-target="#mdlAggiungi">
        <i class="bi bi-pin-map-fill"></i>+ Aggiungi
    </a>

</div>


<div class="card" style="border:none;" id="interf">

    <!-- Riga da rimuovere -->
    <input type="hidden" id="indirizzoDaEliminare" value="" />

    <table class="table table-striped table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th class="text-center">Indirizzo</th>
                <th class="text-center">CAP</th>
                <th class="text-center">Città</th>
                <th class="text-center">Spedizione</th>
                <th class="text-center">Fatturazione</th>
                <th class="text-center">COMANDI</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var indirizzo in Model.CustomerAddresses)
            {
                <tr data-id="@indirizzo.Id" data-isdefault="@indirizzo.IsDefault.ToString().ToLower().Trim()">

                    <td class="text-center">@indirizzo.Address</td>
                    <td class="text-center">@indirizzo.PostalCode</td>
                    <td class="text-center">@indirizzo.City</td>

                    <td class="text-center">
                        @if (indirizzo.IsDefault)
                        {
                            <i class="bi bi-house-fill text-success"></i>
                            <span class="text-success fw-semibold ms-1">Predefinito</span>
                        }
                        else
                        {
                            <span class="text-muted">Alternativo</span>
                        }

                    </td>

                    <td class="text-center">

                        @if (indirizzo.IsBilling)
                        {

                            <i class="bi bi-file-earmark-text-fill text-primary"></i>
                        }
                        else
                        {
                            <span class="text-muted">-- --</span>
                        }

                    </td>
                    <td class="text-center">

                        <!-- TASTO MODIFICA -->
                        <a href="" class="btn btn-sm btn-outline-warning py-1 btnModifica" style="border-radius: 25px;" title="Modifica riga"
                           data-bs-toggle="modal"
                           data-bs-target="#mdlModifica"
                           data-id="@indirizzo.Id"
                           data-address="@indirizzo.Address"
                           data-postalCode="@indirizzo.PostalCode"
                           data-city="@indirizzo.City"
                           data-isDefault="@indirizzo.IsDefault.ToString().ToLower()"
                           data-isBilling="@indirizzo.IsBilling.ToString().ToLower()">

                            <i class="bi bi-pencil"></i>
                        </a>

                        <!-- Tasto elimina-->
                        <button type="button"
                                class="btn btn-sm btn-outline-danger py-1 btnElimina"
                                style="border-radius: 25px;"
                                title="Cancella utente"
                                data-id="@indirizzo.Id">
                            <!-- id che  viene passato alla funzione javascript -->
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }

        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <a href="/Gestutenti/GestioneUtenti" class="btn btn-animated fw-semibold px-4"
           style="border: 1.5px solid #212529; border-radius: 25px; color: #212529; line-height: 24px;">
            ← Indietro
        </a>

    </div>

    <!-- Modale Modifica -->

    <div class="modal fade" id="mdlModifica">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Modifica Indirizzo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Inizio Form  -->
                    <input type="hidden" id="editId" value="" />  <!--  valore popolato quando si clicca sul bottone modifica  -->
                    <!-- Campo hidden per prendere l'id del Customer'-->
                    <input type="hidden" id="editCustomerId" value="@Model.UserDetail.CustomerId" />

                    <div class="mb-3">
                        <label>Indirizzo</label>
                        <input type="text" id="editAddress" placeholder="Aggiungi indirizzo" class="form-control input-animated" />
                    </div>

                    <div class="mb-3">
                        <label>CAP</label>
                        <input type="number" id="editPostalcode" placeholder="Aggiungi Cap" class="form-control input-animated" />
                    </div>

                    <div class="mb-3">
                        <label>Città</label>
                        <input type="text" id="editCity" placeholder="Aggiungi Città" class="form-control input-animated" />
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" id="editIsDefault" class="form-check-input" />
                            <label class="form-check-label">Predefinito</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" id="editIsBilling" class="form-check-input" />
                            <label class="form-check-label">Fatturazione</label>
                        </div>
                    </div>

                    <!--risultato messaggio errore o successo-->
                    <div id="resultMessageModifica"></div>
                </div>

                <div class="modal-footer">
                    <button id="editAnnulla"  type="button" class="btn px-4 btn-secondary" data-bs-dismiss="modal" >
                        Annulla
                    </button>

                    <button type="button" id="btnModificaIndirizzo" class="btn btn-warning px-4">Salva</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODALE AGGIUNGi -->

    <div class="modal fade" id="mdlAggiungi">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Aggiungi Indirizzo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <!-- Inizio Form  -->
                    <!-- Campo hidden per prendere l'id del Customer'-->
                    <input type="hidden" id="CustomerId" value="@Model.UserDetail.CustomerId" />

                    <div class="mb-3">
                        <label>Indirizzo</label>
                        <input type="text" id="txtAddress" placeholder="Aggiungi indirizzo" class="form-control input-animated" />
                    </div>

                    <div class="mb-3">
                        <label>CAP</label>
                        <input type="number" id="txtPostalcode" placeholder="Aggiungi Cap" class="form-control input-animated" />
                    </div>

                    <div class="mb-3">
                        <label>Città</label>
                        <input type="text" id="txtCity" placeholder="Aggiungi Città" class="form-control input-animated" />
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" id="txtIsDefault" class="form-check-input" />
                            <label class="form-check-label">Predefinito</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" id="txtIsBilling" class="form-check-input" />
                            <label class="form-check-label">Fatturazione</label>
                        </div>
                    </div>

                    <!--risultato messaggio errore o successo-->
                    <div id="resultMessageAdd"></div>

                </div>

                <div class="modal-footer">
                    <button type="button" id="addAnnulla" class="btn px-4  btn-secondary" data-bs-dismiss="modal">
                        Annulla
                    </button>

                    <button type="button" id="btnSalvaIndirizzo" class="btn btn-warning px-4">Salva</button>

                </div>

            </div>
        </div>

    </div>


    <!-- MODALE ELIMINA -->
    <div class="modal fade" id="modalElimina">

        <div class="modal-dialog">

            <div class="modal-content">
                <div class="modal-body">
                    Sei sicuro di voler elminare questo indirizzo?
                </div>
                <div class="modal-footer">
                    <button type="button" id="btnAnnulla" class="btn px-4  btn-secondary" data-bs-dismiss="modal">
                        Annulla
                    </button>

                    <button type="button" id="btnConfermaElimina" class="btn btn-danger">Elimina</button>
                </div>
            </div>

        </div>

    </div>

</div>


@section scripts {
    <script>
        var urls = {
            eliminaIndirizzo: '@Url.Action("EliminaIndirizzo", "GestIndirizzi")',
            aggiungiIndirizzo: '@Url.Action("AggiungiIndirizzo", "GestIndirizzi")',
            modificaIndirizzo: '@Url.Action("ModificaIndirizzo", "GestIndirizzi")'
        };
    </script>
    <script src="@Url.Content("~/Scripts/js/IndirizziCustomer.js")"></script>
}
