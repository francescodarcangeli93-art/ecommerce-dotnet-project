            <path d="M11.467,5.71c0.38,-0 0.688,0.308 0.688,0.688c-0,1.697 -0,6.068 -0,7.765c-0,0.38 -0.308,0.688 -0.688,0.688c-0.02,0 -0.041,0 -0.061,0c-0.38,0 -0.688,-0.308 -0.688,-0.688c0,-1.697 0,-6.068 0,-7.765c0,-0.38 0.308,-0.688 0.688,-0.688c0.02,-0 0.041,-0 0.061,-0Z" />
          
            <circle cx="11.35" cy="16.891" r="1.337" />
            </g>
          </svg>


            <h3>Cancella Indirizzo</h3>
            <p>stai cancellando un "Indirizzo"</p>
        </div>
        <div class="buttons">
            <button class="no-btn">No,Tienilo.</button>
            <button class="si-btn">Si,Cancella!</button>
        </div>
    </div>
</div>


@section scripts {
    <script>
        var urls = {
            eliminaIndirizzo: '@Url.Action("EliminaIndirizzo", "GestIndirizzi")',
            aggiungiIndirizzo: '@Url.Action("AggiungiIndirizzo", "GestIndirizzi")',
            modificaIndirizzo: '@Url.Action("ModificaIndirizzo", "GestIndirizzi")'
        };
    </script>
    <script src="@Url.Content("~/Scripts/js/IndirizziCustomer.js")"></script>
}
