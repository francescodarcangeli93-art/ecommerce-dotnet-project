@model WebEcommerce.Models.SupplierViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}

<main class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="fw-bold text-black text-center w-100 titolo-animated">
            Gestione Fornitori
        </h1>
    </div>

    <div class="mb-4 p-4 bg-white card-animated card-detail">
        <h5 class="mb-4 fw-semibold text-dark">Ricerca Fornitori</h5>
        <div >
            <div class="card-body row g-3" id="filtri">
                <div class="col-md-3">
                    @*<label for="txtCompany">Azienda</label>*@
                    <input type="text" id="txtCompany" name="CompanyName" placeholder="Azienda" class="form-control input-animated"/>
                </div>

                <div class="col-md-3">
                    @*<label for="txtReferente">Referente</label>*@
                    <input type="text" id="txtReferente" name="ContactName" placeholder="Referente" class="form-control input-animated"/>
                </div>

                <div class="col-md-3">
                    @*<label for="txtRuolo">Ruolo</label>*@
                    <input type="text" id="txtRuolo" name="ContactTitle"  placeholder="Ruolo" class="form-control input-animated"/>
                </div>
                <div class="col-md-3">
                    @*<label for="txtcitta">Città</label>*@
                    <input type="text" id="txtCitta" name="City"  placeholder="Città" class="form-control input-animated"/>
                </div>
                <div class="col-md-3">
                    @*<label for="txtPaese">Paese</label>*@
                    <input type="text" id="txtPaese" name="Country"  placeholder="Paese" class="form-control input-animated"/>
                </div>

                <div class="col-md-3">
                    @*<label for="txtTelefono">Telefono</label>*@
                    <input type="text" id="txtTelefono" name="Phone"  placeholder="Telefono" class="form-control input-animated"/>
                </div>
                <div class="col-md-3">
                    @*<label for="txtFax">Fax</label>*@
                    <input type="text" id="txtFax" name="Fax" placeholder="Fax" class="form-control input-animated" />
                </div>
                <div class="col-md-3 d-flex align-items-center gap-2 justify-content-end">
                    <button type="button" id="btnCerca" data-url="@Url.Action("SearchSupplier","GestSupplier")" class="btn fw-semibold px-4 btn-animated bt-cerca">Cerca</button>
                    <button type="button" id="btnPulisci" class="btn fw-semibold px-4 btn-animated bt-pulisci">Pulisci</button>
                </div>
            </div>
        </div>
        </div>

    @*TASTO AGGIUNGI*@
    <div class="d-flex justify-content-between align-items-end mb-3">
        <h3 class="m-0">Lista Fornitori</h3>

        <a href="" class="btn fw-semibold px-4 btn-animated buttonAdd">
            <i class="bi bi-truck"></i> Aggiungi
        </a>

    </div>

    <div class="table-responsive bevel">
        <table class="table table-striped table-hover table-bordered align-middle mb-0">
            <thead class="table-dark table-bordered">
                <tr>
                    <th scope="col" class="text-center">Azienda</th>
                    <th scope="col" class="text-center">Referente</th>
                    <th scope="col" class="text-center">Ruolo</th>
                    <th scope="col" class="text-center">Città</th>
                    <th scope="col" class="text-center">Paese</th>
                    <th scope="col" class="text-center">Telefono</th>
                    <th scope="col" class="text-center">Fax</th>
                    <th class="text-center px-4">COMANDI</th>
                </tr>
            </thead>
            <tbody id="corpoTabella">
                @foreach (var sup in Model.SupplierList)
                {
                    <tr>
                        <td class="text-center">@sup.CompanyName</td>
                        <td class="text-center">@sup.ContactName</td>
                        <td class="text-center">@sup.ContactTitle</td>
                        <td class="text-center">@sup.City</td>
                        <td class="text-center">@sup.Country</td>
                        <td>@sup.Phone</td>
                        <td>@sup.Fax</td>

                        <td class="text-end text-ce px-4">
                            <a href="" class="btn btn-sm btn-outline-info py-1 simpleBevel" title="Visualizza Dettagli">
                                <i class="bi bi-search"></i>
                            </a>
                            <a href="" class="btn btn-sm btn-outline-warning py-1 simpleBevel" title="Modifica riga">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <!-- ELIMINA UTENTE -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger py-1 simpleBevel"
                                    title="Cancella fornitore">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>

@section scripts {
    <script src="@Url.Content("~/Scripts/js/GestioneSupplier.js")"></script>
    }
