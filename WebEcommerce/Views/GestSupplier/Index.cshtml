@model WebEcommerce.Models.SupplierViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}

<main class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="fw-bold text-black text-center w-100 titolo-animated">
            Gestione Fornitori
        </h1>
    </div>

    <div class="mb-4 p-4 bg-white card-animated card-detail">
        <h5 class="mb-4 fw-semibold text-dark">Ricerca Fornitori</h5>
        <div>
            <div class="card-body row g-3" id="filtri">
                <div class="col-md-3">
                    @*<label for="txtCompany">Azienda</label>*@
                    <input type="text" id="txtCompany" name="CompanyName" placeholder="Azienda" class="form-control input-animated" />
                </div>

                <div class="col-md-3">
                    @*<label for="txtReferente">Referente</label>*@
                    <input type="text" id="txtReferente" name="ContactName" placeholder="Referente" class="form-control input-animated" />
                </div>

                <div class="col-md-3">
                    @*<label for="txtRuolo">Ruolo</label>*@
                    <input type="text" id="txtRuolo" name="ContactTitle" placeholder="Ruolo" class="form-control input-animated" />
                </div>
                <div class="col-md-3">
                    @*<label for="txtcitta">Città</label>*@
                    <input type="text" id="txtCitta" name="City" placeholder="Città" class="form-control input-animated" />
                </div>
                <div class="col-md-3">
                    @*<label for="txtPaese">Paese</label>*@
                    <input type="text" id="txtPaese" name="Country" placeholder="Paese" class="form-control input-animated" />
                </div>

                <div class="col-md-3">
                    @*<label for="txtTelefono">Telefono</label>*@
                    <input type="text" id="txtTelefono" name="Phone" placeholder="Telefono" class="form-control input-animated" />
                </div>
                <div class="col-md-3">
                    @*<label for="txtFax">Fax</label>*@
                    <input type="text" id="txtFax" name="Fax" placeholder="Fax" class="form-control input-animated" />
                </div>
                <div class="col-md-3 d-flex align-items-center gap-2 justify-content-end">
                    <button type="button" id="btnCerca" data-url="@Url.Action("SearchSupplier","GestSupplier")" class="btn fw-semibold px-4 btn-animated bt-cerca">Cerca</button>
                    <button type="button" id="btnPulisci" class="btn fw-semibold px-4 btn-animated bt-pulisci">Pulisci</button>
                </div>
            </div>
        </div>
    </div>

    @*TASTO AGGIUNGI*@
    <div class="d-flex justify-content-between align-items-end mb-3" id="btnAggiungi">
        <h3 class="m-0">Lista Fornitori</h3>

        <a class="btn fw-semibold px-4 btn-animated buttonAdd">
            <i class="bi bi-truck"></i> Aggiungi
        </a>

    </div>

    <div class="table-responsive bevel">

        <input type="hidden" id="indirizzoDaEliminare" value="" />

        <table class="table table-striped table-hover table-bordered align-middle mb-0">
            <thead class="table-dark table-bordered">
                <tr>
                    <th scope="col" class="text-center">Azienda</th>
                    <th scope="col" class="text-center">Referente</th>
                    <th scope="col" class="text-center">Ruolo</th>
                    <th scope="col" class="text-center">Città</th>
                    <th scope="col" class="text-center">Paese</th>
                    <th scope="col" class="text-center">Telefono</th>
                    <th scope="col" class="text-center">Fax</th>
                    <th class="text-center px-4">COMANDI</th>
                </tr>
            </thead>
            <tbody id="corpoTabella">
                @foreach (var sup in Model.SupplierList)
                {
                    <tr data-id="@sup.Id">
                        <td class="text-center">@sup.CompanyName</td>
                        <td class="text-center">@sup.ContactName</td>
                        <td class="text-center">@sup.ContactTitle</td>
                        <td class="text-center">@sup.City</td>
                        <td class="text-center">@sup.Country</td>
                        <td>@sup.Phone</td>
                        <td>@sup.Fax</td>

                        <td class="text-end text-ce px-4">
                            <a class="btn btn-sm btn-outline-info py-1 simpleBevel btn-dettagli" data-id="@sup.Id" title="Visualizza Dettagli">
                                <i class="bi bi-search"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-warning py-1 simpleBevel btn-modifica" data-id="@sup.Id" title="Modifica riga">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <!-- ELIMINA UTENTE -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger py-1 simpleBevel btn-elimina"
                                    @*data-bs-toggle="modal"*@
                                    @*data-bs-target="#delateModal"*@
                                    title="Cancella fornitore"
                                    data-id="@sup.Id"
                                    data-companyname="@sup.CompanyName">

                                <i class="bi bi-trash"></i>
                            </button>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>

<!-- MODALE ELIMINA -->

<div class="modal fade" id="modalElimina" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Elimina</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Sicuro di voler eliminare il fornitore <strong id="nomeFornitore"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="confermaElimina" data-url="@Url.Action("Delete","GestSupplier")" class="btn btn-danger">Elimina</button>
            </div>
        </div>
    </div>
</div>

<!-- MODALE VISUALIZZA DETTAGLI -->
<div class="modal fade" id="modalDettagli" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Dettagli Fornitore</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="card-body">
                    <label for="txtCompany">Azienda</label>
                    <input type="text" id="showCompany" class="form-control input-animated" readonly />

                    <label for="txtReferente">Referente</label>
                    <input type="text" id="showReferente" name="ContactName" placeholder="Referente" class="form-control input-animated" readonly />

                    <label for="txtRuolo">Ruolo</label>
                    <input type="text" id="showRuolo" name="ContactTitle" placeholder="Ruolo" class="form-control input-animated" readonly />

                    <label for="txtcitta">Città</label>
                    <input type="text" id="showCitta" name="City" placeholder="Città" class="form-control input-animated" readonly />

                    <label for="txtPaese">Paese</label>
                    <input type="text" id="showPaese" name="Country" placeholder="Paese" class="form-control input-animated" readonly />

                    <label for="txtTelefono">Telefono</label>
                    <input type="text" id="showTelefono" name="Phone" placeholder="Telefono" class="form-control input-animated" readonly />

                    <label for="txtFax">Fax</label>
                    <input type="text" id="showFax" name="Fax" placeholder="None" class="form-control input-animated" readonly />
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- MODALE AGGIUNGI Fornitore-->
<div class="modal fade" id="modalAggiungi" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Aggiungi Fornitore</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="mb-4 p-4 bg-white card-animated card-detail">
                    <h5 class="mb-4 fw-semibold text-dark">Aggiungi Fornitore</h5>
                    <div>
                        <div class="card-body row g-3" id="filtri">
                            <div class="col-md-6">

                                <div class="mb-3">
                                    <label for="Company">Azienda</label>
                                    <input type="text" id="Company" name="CompanyName" placeholder="nome Azienda" class="form-control input-animated" required />
                                </div>

                                <div class="mb-3">
                                    <label for="Referente">Referente</label>
                                    <input type="text" id="Referente" name="ContactName" placeholder="nome Referente" class="form-control input-animated" />
                                </div>

                                <div class="mb-3">
                                    <label for="Ruolo">Ruolo</label>
                                    <input type="text" id="Ruolo" name="ContactTitle" placeholder="Ruolo del referente" class="form-control input-animated" />
                                </div>

                                <div class="mb-3">
                                    <label for="Citta">Città</label>
                                    <input type="text" id="Citta" placeholder="es: Roma" name="City" class="form-control input-animated" />
                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="mb-3">
                                    <label for="Paese">Paese</label>
                                    <input type="text" id="Paese" name="Country" placeholder="es:Italia" class="form-control input-animated" />
                                </div>

                                <div class="mb-3">
                                    <label for="Telefono">Telefono</label>
                                    <input type="text" id="Telefono" name="Phone" class="form-control input-animated" />
                                </div>
                                <div class="mb-3">
                                    <label for="Fax">Fax</label>
                                    <input type="text" id="Fax" name="Fax" class="form-control input-animated" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="btnSalva" class="btn btn-success">Salva</button>
            </div>
        </div>
    </div>
</div>

<!-- MODALE MODIFICA Fornitore-->
<div class="modal fade" id="modalEdit" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Modifica Fornitore</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="mb-4 p-4 bg-white card-animated card-detail">
                    <h5 class="mb-4 fw-semibold text-dark">Aggiungi Fornitore</h5>
                    <div>
                        <div class="card-body row g-3" id="filtri">
                            <div class="col-md-6">

                                <input type="hidden" id="editId" />

                                <div class="mb-3">
                                    <label for="editCompany">Azienda</label>
                                    <input type="text" id="editCompany" name="CompanyName" placeholder="nome Azienda" class="form-control input-animated" required />
                                </div>

                                <div class="mb-3">
                                    <label for="editReferente">Referente</label>
                                    <input type="text" id="editReferente" name="ContactName" placeholder="nome Referente" class="form-control input-animated" />
                                </div>

                                <div class="mb-3">
                                    <label for="editRuolo">Ruolo</label>
                                    <input type="text" id="editRuolo" name="ContactTitle" placeholder="Ruolo del referente" class="form-control input-animated" />
                                </div>

                                <div class="mb-3">
                                    <label for="editCitta">Città</label>
                                    <input type="text" id="editCitta" placeholder="es: Roma" name="City" class="form-control input-animated" />
                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="mb-3">
                                    <label for="txtPaese">Paese</label>
                                    <input type="text" id="editPaese" name="Country" placeholder="es:Italia" class="form-control input-animated" />
                                </div>

                                <div class="mb-3">
                                    <label for="txtTelefono">Telefono</label>
                                    <input type="text" id="editTelefono" name="Phone" class="form-control input-animated" />
                                </div>
                                <div class="mb-3">
                                    <label for="txtFax">Fax</label>
                                    <input type="text" id="editFax" name="Fax" class="form-control input-animated" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="btnModifica" class="btn btn-success">Modifica</button>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script src="@Url.Content("~/Scripts/js/GestioneSupplier.js")"></script>
}
