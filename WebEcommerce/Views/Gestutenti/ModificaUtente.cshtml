@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model WebEcommerce.Models.GestioneUtentiViewModel

<style>
    .form-control, .form-select {
        border-radius: 25px !important;
        border: 1.5px solid #ddd !important;
        padding: 10px 18px !important;
        transition: all 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #212529 !important;
            box-shadow: 0 0 0 3px rgba(33,37,41,0.1) !important;
        }

    .btn-animated {
        transition: all 0.3s ease;
    }

        .btn-animated:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(33,37,41,0.3);
        }

    .sezione-titolo {
        font-size: 11px;
        letter-spacing: .08em;
        color: #6c757d;
    }
</style>

<main class="container mt-4">

    <h1 class="fw-bold mb-4" style="font-size: 2rem; border-left: 4px solid #ffc107; padding-left: 12px;">
        Modifica Utente
    </h1>

    <form id="formModifica" action="/Gestutenti/ModificaUtente" method="POST">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="CustomerId" value="@Model.CustomerId" />

        <div class="row g-4">

            <div class="col-md-6">
                <div class="bg-white p-4" style="border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.08);">

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="d-flex align-items-center justify-content-center fw-bold text-white"
                             style="width:50px; height:50px; border-radius:50%; background-color:#212529; font-size:18px;">
                            @(Model.FirstName?.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "U")@(Model.LastName?.Length > 0 ? Model.LastName[0].ToString().ToUpper() : "")
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">@Model.Username</h5>
                            <small class="text-muted">@Model.Email</small>
                        </div>
                    </div>

                    <p class="text-uppercase fw-semibold sezione-titolo mb-3">Credenziali</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Username</label>
                        <input type="text" id="username" name="Username" value="@Model.Username" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="text" name="Email" value="@Model.Email" class="form-control" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Password</label>

                        <div style="display: flex !important; align-items: stretch !important; border: 1.5px solid #ddd !important; border-radius: 25px !important; overflow: hidden !important; max-width: 330px !important; width: 100% !important;">

                            <input type="password" id="password" name="Password" value="@Model.Password"
                                   style="border: none !important; outline: none !important; padding: 10px 18px !important; flex: 1 !important; width: 100% !important; box-shadow: none !important; border-radius: 0 !important; background-color: transparent !important;" required />

                            <button type="button" onclick="togglePass()"
                                    style="background-color: #212529 !important; color: white !important; border: none !important; padding: 0 16px !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important;">
                                <i id="iconaEye" class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <hr style="border-color: #f0f0f0;" />

                    <p class="text-uppercase fw-semibold sezione-titolo mb-3">Account</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ruolo</label>
                        <select name="RoleId" id="roleId" class="form-select" onchange="mostraNascondiCustomer()">
                            @foreach (var role in Model.ListRuoli)
                            {
                                <option value="@role.Id" @(Model.RoleId != null && role.Id == Model.RoleId ? "selected" : "")>
                                    @role.RoleName
                                </option>
                            }
                        </select>
                    </div>

                </div>
            </div>

            <div class="col-md-6">
                <div id="DatiPersonali" class="bg-white p-4" style="border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); display: none;">

                    <p class="text-uppercase fw-semibold sezione-titolo mb-3">Dati personali</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nome</label>
                        <input type="text" id="nome" name="FirstName" value="@Model.FirstName" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cognome</label>
                        <input type="text" id="cognome" name="LastName" value="@Model.LastName" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Città</label>
                        <input type="text" name="City" value="@Model.City" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nazione</label>
                        <input type="text" name="Country" value="@Model.Country" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Telefono</label>
                        <input type="text" name="Phone" value="@Model.Phone" class="form-control" />
                    </div>

                </div>
            </div>

        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <a href="/Gestutenti/GestioneUtenti" class="btn btn-animated fw-semibold px-4"
               style="border: 1.5px solid #212529; border-radius: 25px; color: #212529; line-height: 24px;">
                ← Indietro
            </a>
            <button type="button" class="btn btn-animated fw-bold px-4"
                    style="background-color: #ffc107; color: #212529; border-radius: 25px; border: none; padding: 10px 24px;"
                    onclick="confermaModifica()">
                ✓ Salva modifiche
            </button>
        </div>

    </form>
</main>

<div class="modal fade" id="modalConferma" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Conferma modifiche</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-1">Sei sicuro di voler modificare i dati di:</p>
                <p class="fw-bold fs-5 mb-0" id="nomeUtenteModal"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn px-4" data-bs-dismiss="modal"
                        style="border: 1.5px solid #212529; border-radius: 25px;">
                    No
                </button>
                <button type="button" class="btn fw-bold px-4" onclick="submitForm()"
                        style="background-color: #ffc107; color: #212529; border-radius: 25px; border: none;">
                    Sì, modifica
                </button>
            </div>
        </div>
    </div>
</div>




@if (TempData["MessaggioSuccesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-2 shadow-sm d-flex align-items-center mb-4" role="alert">
        <i class="fa-solid fa-circle-check fs-5 me-3"></i>

        <div>
            <strong> @TempData["MessaggioSuccesso"]</strong>
        </div>

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}



<div class="text-end">


</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        mostraNascondiCustomer();
    });

    function mostraNascondiCustomer() {
        const roleId = document.getElementById('roleId').value;
        const selezioneDati = document.getElementById('DatiPersonali');
        const inputsDati = selezioneDati.querySelectorAll('input');
        if (roleId !== '' && roleId != '1') {
            selezioneDati.style.display = 'block';
        } else {
            selezioneDati.style.display = 'none';
            inputsDati.forEach(input => input.value = '');
        }
    }

    function confermaModifica() {
        const nome = document.getElementById('nome')?.value || '';
        const cognome = document.getElementById('cognome')?.value || '';
        const nomeCompleto = (nome + ' ' + cognome).trim() || document.getElementById('username')?.value || '';
        document.getElementById('nomeUtenteModal').textContent = nomeCompleto;
        const modal = new bootstrap.Modal(document.getElementById('modalConferma'));
        modal.show();
    }

    function submitForm() {
        document.getElementById('formModifica').submit();
    }

    function togglePass() {
        const inp = document.getElementById('password');
        const icona = document.getElementById('iconaEye');
        inp.type = inp.type === 'password' ? 'text' : 'password';
        icona.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
    }
</script>