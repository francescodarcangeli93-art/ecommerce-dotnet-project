@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model WebEcommerce.Models.GestioneUtentiViewModel


@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}



<main class="container mt-4">

    <h1 class="fw-bold mb-4" style="font-size: 2rem; border-left: 4px solid #ffc107; padding-left: 12px;">
        Modifica Utente
    </h1>

    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center justify-content-center fw-bold text-white avatar-circle">
            @(Model.FirstName?.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "U")@(Model.LastName?.Length > 0 ? Model.LastName[0].ToString().ToUpper() : "")
        </div>
        <div>
            <h5 class="mb-0 fw-bold">@Model.Username</h5>
            <small class="text-muted">@Model.Email</small>
        </div>
    </div>

    <form id="formModifica" action="@Url.Action("ModificaUtente","Gestutenti")" method="POST">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="CustomerId" value="@Model.CustomerId" />

       
        <div class="row g-4 align-items-stretch">
            <!-- Credenziali -->
            <div class="col-md-6">
                <div class="bg-white p-4 card-custom-shadow h-100">

                    <p class="text-uppercase fw-semibold sezione-titolo mb-3">Credenziali</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Username</label>
                        <input type="text" id="username" name="Username" value="@Model.Username" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="text" name="Email" value="@Model.Email" class="form-control" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Password</label>

                        <div class="password-wrapper">

                            <input type="password" id="password" name="Password" value="@Model.Password" class="password-input" required />

                            <button type="button" onclick="togglePass()" class="password-toggle-btn">
                                <i id="iconaEye" class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <hr style="border-color: #f0f0f0;" />

                    <p class="text-uppercase fw-semibold sezione-titolo mb-3">Account</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ruolo</label>
                        <select name="RoleId" id="roleId" class="form-select" onchange="mostraNascondiCustomer()">
                            @foreach (var role in Model.ListRuoli)
                            {
                                <option value="@role.Id" @(Model.RoleId != null && role.Id == Model.RoleId ? "selected" : "")>
                                    @role.RoleName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-medium text-dark">Stato</label>
                        <div class="d-flex gap-4 mt-1">

                            <div class="form-check">
                                <input type="radio" id="statoAttivo" name="IsActive" value="true"
                                       class="form-check-input" @(Model.IsActive ? "checked" : "") />
                                <label for="statoAttivo" class="form-check-label fw-medium text-dark">Attivo</label>
                            </div>

                            <div class="form-check">
                                <input type="radio" id="statoDisattivo" name="IsActive" value="false"
                                       class="form-check-input" @(!Model.IsActive ? "checked" : "") />
                                <label for="statoDisattivo" class="form-check-label fw-medium text-dark">Disattivo</label>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <!-- Dati personali -->

            <div class="col-md-6">
                <div id="DatiPersonali" class="bg-white p-4 h-100" style="border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); display: none;">

                    <p class="text-uppercase fw-semibold sezione-titolo mb-3">Dati personali</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nome</label>
                        <input type="text" id="nome" name="FirstName" value="@Model.FirstName" class="form-control" placeholder="Inserire nome" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cognome</label>
                        <input type="text" id="cognome" name="LastName" value="@Model.LastName" class="form-control" placeholder="Inserire cognome" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Città</label>
                        <input type="text" name="City" value="@Model.City" class="form-control" placeholder="Inserire città" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nazione</label>
                        <input type="text" name="Country" value="@Model.Country" class="form-control" placeholder="Inserire nazione" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Telefono</label>
                        <input type="text" name="Phone" value="@Model.Phone" placeholder="Inserire numero telfonico" class="form-control" />
                    </div>

                </div>
            </div>

        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">

            <a href="/Gestutenti/GestioneUtenti" class="btn btn-animated fw-semibold px-4"
               style="border: 1.5px solid #212529; border-radius: 25px; color: #212529; line-height: 24px;">
                ← Indietro
            </a>

            <button type="button" class="btn btn-animated fw-bold px-4"
                    style="background-color: #ffc107; color: #212529; border-radius: 25px; border: none; padding: 10px 24px;"
                    onclick="confermaModifica()">
                ✓ Salva modifiche
            </button>

        </div>


    </form>

</main>

@*Stampa messaggio di di successo e di errore*@





<!--MODAL di conferma-->
<div class="modal fade" id="modalConferma">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content shows" style="border-radius: 25px;">

            <div class="modal-header">
                <h5 class="modal-title fw-bold">Conferma modifiche</h5>

            </div>

            <div class="modal-body">
                <p>sei sicuro di voler modificare ?</p>
            </div>


            <div class="modal-footer">

                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">anulla</button>

                <button class="btn"></button>
                <button type="submit" class="btn btn-primary" id="btnSalvaModifica" onclick="submitForm()">Si conferma</button>


            </div>
        </div>

    </div>

</div>



@*------------------------------------------------------------------------------------------------------------------------*@

@if (TempData["Successo"] != null)
{

    <div id="successo" class="alert alert-success alert-dismissible fade show border-2 shadow-sm d-flex align-items-center mb-4" role="alert">
        <i class="fa-solid fa-circle-check fs-5 me-3"></i>

        <div>
            <strong> @TempData["Successo"]</strong>
        </div>

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

    </div>

}

<div class="text-end">

</div>


<script src="@Url.Content("~/Scripts/js/ModificaUtente.js")"></script>
<script src="@Url.Content("~/Scripts/js/Password.js")"></script>