﻿@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model WebEcommerce.Models.GestioneUtentiViewModel

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}

<main class="container mt-4">

    <h1 class="fw-bold mb-4" style="font-size: 2rem; border-left: 4px solid #ffc107; padding-left: 12px;">
        Aggiungi utente
    </h1>

    @if (ViewBag.Successo != null)
    {
        <div class="alert alert-success d-flex align-items-center border-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3"></i>
            <div>
                <strong>Operazione completata:</strong> @ViewBag.Successo
            </div>
        </div>
    }

    @if (ViewBag.Errore != null)
    {
        <div class="alert alert-danger d-flex align-items-center border-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div>
                <strong>Attenzione:</strong> @ViewBag.Errore
            </div>
        </div>
    }

    <form id="formAggiungi"action="@Url.Action("AggiungiUtente", "Gestutenti")" method="Post">

        <div class="row g-4  align-items-stretch">

            <!-- Colonna sinistra: Credenziali + Account -->
            <div class="col-md-6">
                <div class="bg-white p-4 h-100" style="border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.08);">

                    <p class="text-uppercase fw-semibold sezione-titolo mb-3">Credenziali</p>

                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold">Username*</label>
                        <input type="text" id="username" name="Username" class="form-control" required placeholder="Inserire nome utente" />
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">Email*</label>
                        <input type="email" id="email" name="Email" class="form-control" placeholder="nome@esempio.it" required />
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold">Password*</label>
                        <div class="password-wrapper">
                            <input type="password" id="password" name="Password"  class="password-input"  placeholder="Inserire la password" required />
                            <button type="button" onclick="togglePass()"
                                    style="background-color: #212529 !important; color: white !important; border: none !important; padding: 0 16px !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important;">
                                <i id="iconaEye" class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <hr style="border-color: #f0f0f0;" />

                    <p class="text-uppercase fw-semibold sezione-titolo mb-3">Account</p>

                    <div class="mb-3">
                        <label for="roleId" class="form-label fw-semibold">Ruolo*</label>
                        <select id="roleId" name="RoleId" class="form-select" onchange="mostraNascondiCustomer()" required>
                            <option value="" disabled>-- seleziona un ruolo --</option>
                            @if (Model != null && Model.ListRuoli != null)
                            {
                                foreach (var ruolo in Model.ListRuoli)
                                {
                                    <option value="@ruolo.Id">@ruolo.RoleName</option>
                                }
                            }
                        </select>
                    </div>

                </div>
            </div>

            <!-- Colonna destra: Dati personali (solo se Customer) -->
            <div class="col-md-6">
                <div id="DatiPersonali" class="bg-white p-4 h-100" style="border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); display: none;">

                    <p class="text-uppercase fw-semibold sezione-titolo mb-3">Dati cliente</p>

                    <div class="mb-3">
                        <label for="nome" class="form-label fw-semibold">Nome*</label>
                        <input type="text" id="nome" name="FirstName" class="form-control" placeholder="Inserire nome" required />
                    </div>

                    <div class="mb-3">
                        <label for="cognome" class="form-label fw-semibold">Cognome*</label>
                        <input type="text" id="cognome" name="LastName" class="form-control" placeholder="Inserire cognome" required />
                    </div>

                    <div class="mb-3">
                        <label for="citta" class="form-label fw-semibold">Città</label>
                        <input type="text" id="citta" name="City" class="form-control" placeholder="Inserire città" />
                    </div>

                    <div class="mb-3">
                        <label for="nazione" class="form-label fw-semibold">Nazione</label>
                        <input type="text" id="nazione" name="Country" class="form-control" placeholder="Inserire nazione" />
                    </div>

                    <div class="mb-3">
                        <label for="telefono" class="form-label fw-semibold">Telefono</label>
                        <input type="text" id="telefono" name="Phone" class="form-control" placeholder="Inserire numero telefonico" />
                    </div>

                </div>
            </div>

        </div>

        <!-- Azioni -->
        <div class="d-flex justify-content-between align-items-center mt-4">
            <a href="/Gestutenti/GestioneUtenti" class="btn btn-animated fw-semibold px-4"
               style="border: 1.5px solid #212529; border-radius: 25px; color: #212529; line-height: 24px;">
                ← Indietro
            </a>
            <button type="submit" class="btn btn-animated fw-bold px-4"
                    style="background-color: #ffc107; color: #212529; border-radius: 25px; border: none; padding: 10px 24px;"
                    >
                ✓ Salva
            </button>
        </div>

    </form>

</main>


<!-- Modal conferma -->
<div class="modal fade" id="modalConferma" tabindex="-1" aria-labelledby="modalConfermaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 25px;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalConfermaLabel">Conferma modifiche</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body py-4">
                <p class="text-dark mb-1">Sei sicuro di voler aggiungere i dati di:</p>
                <p class="fw-semibold text-dark fs-5 mb-0" id="nomeUtenteModal"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" onclick="submitForm()">Sì, aggiungi</button>
            </div>
        </div>
    </div>
</div>


<script src="@Url.Content("~/Scripts/js/AggiungiUtente.js")"></script>