@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model WebEcommerce.Models.GestioneUtentiViewModel



<main class="container mt-4">
    <div class="card border-2 shadow-sm">

        <h1 class="mb-0 text-dark">Aggiungi utente</h1>


        <div class="card-body px-4 py-4">


            @if (ViewBag.Successo != null)
            {
                <div class="alert alert-success d-flex align-items-center border-2 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                    <div>
                        <strong>Operazione completata:</strong> @ViewBag.Successo
                    </div>
                </div>
            }


            @if (ViewBag.Errore != null)
            {
                <div class="alert alert-danger d-flex align-items-center border-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                    <div>
                        <strong>Attenzione:</strong> @ViewBag.Errore
                    </div>
                </div>
            }

            @*INIZIO FORM*@

            <form id="formAggiungi" action="/Gestutenti/AggiungiUtente" method="Post">



                <!-- Credenziali -->
                <p class="text-uppercase fw-semibold text-dark mb-3" style="font-size:15px;letter-spacing:.08em;">Credenziali</p>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="username" class="form-label fw-medium text-dark">Username</label>
                        <input type="text" id="username" name="Username" class="form-control border-2" required  placeholder="Inserire nome utente" />
                    </div>
                    <div class="col-md-6">
                        <label for="email" class="form-label fw-medium text-dark">Email</label>
                        <input type="email" id="email" name="Email" class="form-control border-2"    placeholder="nome@esempio.it" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label fw-medium text-dark" >Password</label>
                    <div class="input-group">
                        <input type="password" id="password" name="Password" class="form-control border-2"  placeholder="Inserire la password" required />
                        <button class="btn btn-outline-secondary border-2" type="button" id="btnOcchiolino" onclick="togglePass()">
                            <i id="iconaEye" class="bi bi-eye"></i>
                        </button>
                    </div>

                </div>

                <hr class="border-2 border-dark border-opacity-25 my-4" />

                <!-- Account -->
                <p class="text-uppercase fw-semibold text-dark mb-3" style="font-size:11px;letter-spacing:.08em;">Account</p>
                <div class="row g-3 mb-4">

                    <div class="col-md-4">
                        <label for="roleId" class="form-label fw-medium text-dark">Ruolo</label>

                        <select id="roleId" name="RoleId" class="form-select border-2" onchange="mostraNascondiCustomer()"  required>
                            <option value="" disabled  >-- seleziona un ruolo --</option>
                            @if (Model != null && Model.ListRuoli != null)
                            {
                                foreach (var ruolo in Model.ListRuoli)
                                {
                                    <option  value="@ruolo.Id">@ruolo.RoleName</option>
                                }
                            }

                        </select>

                    </div>

                </div>

                <!-- Dati personali (solo se nella select si attiva Customer ) -->
                <div id="sezioneDatiPersonali" style="display: none;">

                    <hr class="border-2 border-dark border-opacity-25 my-4" />
                    <p class="text-uppercase fw-semibold text-dark mb-3" style="font-size:15px;letter-spacing:.08em;">Dati cliente</p>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="nome" class="form-label fw-medium text-dark">Nome</label>
                            <input type="text" id="nome" name="FirstName" class="form-control border-2" />
                        </div>
                        <div class="col-md-6">
                            <label for="cognome" class="form-label fw-medium text-dark">Cognome</label>
                            <input type="text" id="cognome" name="LastName" class="form-control border-2" />
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label for="citta" class="form-label fw-medium text-dark">Città</label>
                            <input type="text" id="citta" name="City" class="form-control border-2" />
                        </div>
                        <div class="col-md-4">
                            <label for="nazione" class="form-label fw-medium text-dark">Nazione</label>
                            <input type="text" id="nazione" name="Country" class="form-control border-2" />
                        </div>
                        <div class="col-md-4">
                            <label for="telefono" class="form-label fw-medium text-dark">Telefono</label>
                            <input type="text" id="telefono" name="Phone" class="form-control border-2" />
                        </div>
                    </div>
                </div>

                <!-- Azioni -->

                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-2 border-dark border-opacity-25">

                    @*<a href="/Gestutenti/GestioneUtenti" class="btn btn-link text-dark fw-medium text-decoration-none">
                    &larr; Torna indietro
                </a>*@

                    <div class="d-flex gap-2">

                        <a href="/Gestutenti/GestioneUtenti" class="btn btn-outline-secondary px-4">
                            &larr;  indietro
                        </a>

                        <button type="button" class="btn btn-dark px-4" onclick="confermaModifica()">
                            ✓ Salva
                        </button>
                    </div>
                </div>

            </form>


        </div>
    </div>
</main>

<!-- Modal conferma -->
<div class="modal fade" id="modalConferma" tabindex="-1" aria-labelledby="modalConfermaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-2">
            <div class="modal-header border-bottom border-2 border-dark border-opacity-25">
                <h5 class="modal-title fw-semibold text-dark" id="modalConfermaLabel">
                    Conferma modifiche
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>

            </div>
            <div class="modal-body py-4">
                <p class="text-dark mb-1">Sei sicuro di voler aggiungere i dati di:</p>
                <p class="fw-semibold text-dark fs-5 mb-0" id="nomeUtenteModal"></p>
            </div>
            <div class="modal-footer border-top border-2 border-dark border-opacity-25">

                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">No</button>

                <button type="button" class="btn btn-dark px-4" onclick="submitForm()">Sì, aggiungi</button>
            </div>
        </div>
    </div>
</div>



<script>

    function mostraNascondiCustomer() {

        const roleId = document.getElementById('roleId').value;
        const selezioneDati = document.getElementById('sezioneDatiPersonali');
        const inputsDati = selezioneDati.querySelectorAll('input');

        // Se il ruolo selezione è 1 viene mostrato il form dei customer

        if (roleId !== '' && roleId !== '1') {
            selezioneDati.style.display = 'block';
        } else {
            //Altrimenti nascondiamo il form e svuotiamo i campi per sicurezza
            selezioneDati.style.display = 'none';
            inputsDati.forEach(input => input.value = '');
        }
    }




    const valoriOriginali = {};
    document.querySelectorAll('#formModifica input:not([type=hidden]), #formModifica select')
        .forEach(el => {
            valoriOriginali[el.id] = el.type === 'radio' ? el.checked : el.value;
        });

/*
    function annullaModifiche() {
        document.querySelectorAll('#formModifica input:not([type=hidden]), #formModifica select')
            .forEach(el => {
                if (el.type === 'radio') {
                    el.checked = valoriOriginali[el.id];
                } else {
                    el.value = valoriOriginali[el.id];
                }
            });
    }
*/


    function confermaModifica() {
        const nome = document.getElementById('nome')?.value || '';
        const cognome = document.getElementById('cognome')?.value || '';
        const nomeCompleto = (nome + ' ' + cognome).trim() || document.getElementById('username')?.value || '';
        document.getElementById('nomeUtenteModal').textContent = nomeCompleto;
        const modal = new bootstrap.Modal(document.getElementById('modalConferma'));
        modal.show();
    }

    function submitForm() {
        const form = document.getElementById('formAggiungi');
        form.action = '/Gestutenti/AggiungiUtente';
        form.method = 'POST';
        form.submit();
    }

    function togglePass() {
        const inp = document.getElementById('password');
        const icona = document.getElementById('iconaEye');
        inp.type = inp.type === 'password' ? 'text' : 'password';
        icona.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
    }

</script>