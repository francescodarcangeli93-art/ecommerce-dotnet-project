

@if (TempData["Successo"] != null)
{
    <div id="alertSuccesso" class="alert alert-success">@TempData["Successo"]</div>
}
@if (TempData["Errore"] != null)
{
    <div id="alertErrore" class="alert  alert-danger">@TempData["Errore"]</div>
}

<div class="card" style="border-radius: 16px; border: none; box-shadow: 0 2px 12px rgba(0,0,0,0.08);">
    <div class="card-body p-0">

        @*TASTO AGGIUNGI*@
        <div class="d-flex justify-content-between align-items-end mb-3">
            <h3 class="m-0">Lista Utenti</h3>

            <a href="/Gestutenti/AggiungiUtente" class="btn fw-semibold px-4 btn-animated"
               style="background-color: #ffc107; color: #212529; border-radius: 25px; padding: 6px 24px; border: none;">
                <i class="bi bi-person-plus-fill me-2"></i> Aggiungi
            </a>
        </div>

        <div class="table-responsive" style="border-radius: 15px; overflow: hidden">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-dark  background-color: #212529;">
                    <tr>
                        <th>Username</th>
                        <th>Ruolo</th>
                        <th>Nome</th>
                        <th>Cognome</th>
                        <th>Email</th>
                        <th>Inizio Validità</th>
                        <th>Fine Validità</th>
                        <th class="text-center">Tipo Utente</th>
                        <th class="text-center">Attivo</th>
                        <th class="text-end px-4">COMANDI</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.ListaUtenti != null)
                    {
                        if (Model.ListaUtenti.Count > 0)
                        {
                            foreach (var utente in Model.ListaUtenti)
                            {
                                <tr class="@(ViewData["Id"] != null && utente.Id == (int)ViewData["Id"] ? "table-warning" : "")">

                                    <td>
                                        <span class="fw-semibold">@utente.Username</span>
                                    </td>
                                    <td>
                                        <span class="badge fw-semibold" style="background-color: #212529; border-radius: 25px; padding: 6px 12px;">@utente.RoleName</span>
                                    </td>
                                    <td>@utente.FirstName</td>
                                    <td>@utente.LastName</td>
                                    <td>@utente.Email</td>
                                    <td style="white-space: nowrap;">@utente.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td></td>
                                    <td class="text-center">
                                        @if (utente.CustomerId == null)
                                        {
                                            <i class="bi bi-shield-lock-fill" style="color: #212529; font-size: 1.2rem;" title="Admin"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-circle" style="color: #ffc107; font-size: 1.2rem;" title="Customer"></i>
                                        }
                                    </td>
                                    <td>
                                        <form action="/Gestutenti/CambiaStatoInTabella" method="POST" class="d-inline">
                                            <input type="hidden" name="id" value="@utente.Id" />
                                            <input type="hidden" name="customerId" value="@utente.CustomerId" />

                                            <input type="hidden" name="isActive" value="@((!utente.IsActive).ToString().ToLower())" />
                                            <button type="submit"
                                                    class="btn btn-sm fw-bold text-uppercase d-inline-flex align-items-center justify-content-center border-2 @(utente.IsActive ? "btn-outline-success text-success bg-success bg-opacity-10" : "btn-outline-danger text-danger bg-danger bg-opacity-10")"
                                                    style="font-size: 11px; letter-spacing: .05em; min-width: 105px; height: 31px; border-radius: 25px; white-space: nowrap;">
                                                @(utente.IsActive ? "Attivo" : "Non Attivo")
                                            </button>
                                        </form>

                                    </td>
                                    <td class="text-end text-ce px-4" style="white-space: nowrap;">
                                        <a href="/Gestutenti/DatiUtente?Id=@utente.Id&CustomerId=@utente.CustomerId" class="btn btn-sm btn-outline-info py-1" style="border-radius: 25px;" title="Visualizza Dettagli">
                                            <i class="bi bi-search"></i>
                                        </a>
                                        <a href="/Gestutenti/ModificaUtente?Id=@utente.Id" class="btn btn-sm btn-outline-warning py-1" style="border-radius: 25px;" title="Modifica riga">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger py-1"
                                                style="border-radius: 25px;"
                                                title="Cancella utente"
                                                onclick="confermaEliminazione('@utente.Id', '@utente.Username')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4 fw-semibold">
                                    <i class="bi bi-exclamation-circle me-2"></i> UTENTE NON TROVATO
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@*MODALE*@
<div class="modal fade" id="modalElimina" tabindex="-1" aria-labelledby="modalEliminaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">


            <div class="modal-header border-0">
                <h5 class="modal-title" id="modalEliminaLabel">Conferma eliminazione</h5>
            </div>


            <div class="modal-body">
                Sei sicuro di voler eliminare l'utente <strong id="nomeUtenteDaEliminare"></strong>?
                Questa operazione non può essere annullata.
            </div>


            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>

                <!-- FORM  Elimina -->


                <form id="formElimina" action="/Gestutenti/EliminaUtente" method="POST">

                    <input type="hidden" name="Id" id="Id" />
                    <button type="submit" class="btn btn-danger">Sì, elimina</button>
                </form>


            </div>
        </div>
    </div>
</div>

</main>




<script src="@Url.Content("~/Scripts/js/GestioneUtenti.js")"></script>