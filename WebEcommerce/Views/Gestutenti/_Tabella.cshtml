
@model WebEcommerce.Models.GestioneUtentiViewModel

@if (TempData["Successo"] != null)
{
    <div id="alertSuccesso" class="alert alert-success">@TempData["Successo"]</div>
}
@if (TempData["Errore"] != null)
{
    <div id="alertErrore" class="alert  alert-danger">@TempData["Errore"]</div>
}

<div class="card noborder" >
    <div class="card-body p-0">

        @*TASTO AGGIUNGI*@
        <div class="d-flex justify-content-between align-items-end mb-3">
            <h3 class="m-0">Lista Utenti</h3>
            <a href="@Url.Action("AggiungiUtente", "Gestutenti")" class="btn fw-semibold px-4 btn-animated buttonAdd"
              >
                <i class="bi bi-person-plus-fill me-2"></i> Aggiungi
            </a>
        </div>

        <div class="table-responsive bevel" >
            <table id="tblUser" class="table table-striped table-hover table-bordered align-middle mb-0" >
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">Ruolo<span></span></th>
                        <th data-column="1" class="text-center">Username <span></span></th>
                        <th data-column="2" class="text-center">Nome <span></span></th>
                        <th data-column="3" class="text-center">Cognome <span></span></th>
                        <th data-column="4" class="text-center">Email <span></span></th>
                        <th data-column="5">Inizio Validità <span></span></th>
                        <th class="text-center">Fine Validità</th>
                        <th class="text-center px-4">INDIRIZZI</th>
                        <th class="text-center">Attivo</th>
                        <th class="text-center px-4">COMANDI</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.ListaUtenti != null)
                    {
                        if (Model.ListaUtenti.Count > 0)
                        {
                            foreach (var utente in Model.ListaUtenti)
                            {
                                <tr class="@(ViewData["Id"] != null && utente.Id == (int)ViewData["Id"] ? "table-warning" : "")">


                                    <td class="text-center">
                                        <i class="@utente.IconUserRole" style="color: #212529; font-size: 1.2rem;" title="@utente.RoleName"></i>

                                    </td>

                                    <td>
                                        <span class="fw-semibold">@utente.Username</span>
                                    </td>

                                    <td>@utente.FirstName</td>
                                    <td>@utente.LastName</td>
                                    <td class="text-center">@utente.Email</td>
                                    <td >@utente.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">-- --</td>

                                
                                   
                                    <!-- GESTIONE DEGLI INDIRIZZI -->
                                    <td class="text-center">
                                        @if (utente.CustomerId != null && utente.RoleName.ToString().ToLower() != "admin")
                                        {
                                            <a href="@Url.Action("Index", "GestIndirizzi", new { id = utente.Id })"
                                               class="btn btn-sm btn-outline-success py-1 d-inline-block simpleBevel">
                                                <i class="bi bi-pin-map-fill"></i>
                                            </a>
                                        }
                                       
                                    </td>
                                 
                                    <!-- GESTIONE ATTIVO NON ATTIVO -->
                                    <td class="text-center">
                                        <form action="@Url.Action("CambiaStatoInTabella","Gestutenti")" method="POST" class="d-inline">
                                            <input type="hidden" name="id" value="@utente.Id" />
                                            <input type="hidden" name="customerId" value="@utente.CustomerId" />
                                            <input type="hidden" name="isActive" value="@((!utente.IsActive).ToString().ToLower())" />

                                            <button type="submit"
                                                    class="btn btn-sm fw-bold text-uppercase d-inline-flex align-items-center justify-content-center border-2 attivo
                                                    @(utente.IsActive ? "btn-outline-success text-success bg-success bg-opacity-10" : "btn-outline-danger text-danger bg-danger bg-opacity-10")">
                                                @(utente.IsActive ? "Attivo" : "Non Attivo")
                                            </button>
                                        </form>

                                    </td>


                                    <td class="text-end text-ce px-4">
                                        <a href="@Url.Action("DatiUtente", "Gestutenti", new { Id = utente.Id, CustomerId = utente.CustomerId })" class="btn btn-sm btn-outline-info py-1 simpleBevel" title="Visualizza Dettagli">
                                            <i class="bi bi-search"></i>
                                        </a>
                                        <a href="/Gestutenti/ModificaUtente?Id=@utente.Id" class="btn btn-sm btn-outline-warning py-1 simpleBevel"  title="Modifica riga">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- ELIMINA UTENTE -->
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger py-1 simpleBevel"                                   
                                                title="Cancella utente"
                                                onclick="confermaEliminazione('@utente.Id', '@utente.Username')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4 fw-semibold">
                                    <i class="bi bi-exclamation-circle me-2"></i> UTENTE NON TROVATO
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



@*MODALE*@

<div class="modal fade" id="modalElimina" tabindex="-1" aria-labelledby="modalEliminaLabel" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false"
     data-backdrop="static" data-keyboard="false">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">


            <div class="modal-header border-0">
                <h5 class="modal-title" id="modalEliminaLabel">Conferma eliminazione</h5>
            </div>


            <div class="modal-body">
                Sei sicuro di voler eliminare l'utente <strong id="nomeUtenteDaEliminare"></strong>?
                Questa operazione non può essere annullata.
            </div>


            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>

                <!-- FORM  Elimina -->

                <form id="formElimina" action="@Url.Action("EliminaUtente","Gestutenti")" method="POST">

                    <input type="hidden" name="Id" id="idUtenteDaEliminare" />
                    <button type="submit" class="btn btn-danger">Sì, elimina</button>
                </form>

            </div>
        </div>
    </div>
</div>



