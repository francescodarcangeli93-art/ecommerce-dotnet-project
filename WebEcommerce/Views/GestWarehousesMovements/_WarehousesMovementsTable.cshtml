@model WebEcommerce.Models.WarehousesViewModel

<div class="table-responsive bevel">

    <input type="hidden" id="indirizzoDaEliminare" value="" />

    <table class="table table-striped table-hover table-bordered align-middle mb-0">
        <thead class="table-dark table-bordered">
            <tr>
                <th scope="col" class="text-center">Data</th>
                <th scope="col" class="text-center">Nome Magazzino</th>
                <th scope="col" class="text-center">Nome Prodotto</th>
                <th scope="col" class="text-center">Nome Fornitore</th>
                <th scope="col" class="text-center">Quantità</th>
                <th scope="col" class="text-center">Causale</th>
                <th scope="col" class="text-center">Note</th>
                <th class="text-center col-shrink-15">COMANDI</th>
            </tr>
        </thead>
        <tbody id="corpoTabella">
         @foreach(var ware in Model.TheWarehouseMovements)
            {
                <tr data-id="@ware.MovementId">
                    <td class="text-start">@ware.Date</td>
                    <td class="text-start">@ware.WarehouseName</td>
                    <td class="text-start">@ware.ProductName</td>
                    <td class="text-start">@ware.CompanyName</td>
                    <td class="text-center icon @(ware.quntityClass)">@ware.QuantityEdit</td>
                    <td class="text-start">@ware.Description</td>
                    <td class="text-start">@ware.Notes</td>


                    <td class="text-ce px-4 spazio-comandi">
                        <button class="btn btn-sm btn-outline-info py-1 simpleBevel btn-dettagli" data-id="@ware.MovementId" title="Visualizza Dettagli">
                            <i class="bi bi-search"></i>
                        </button>
                        <a class="btn btn-sm btn-outline-warning py-1 simpleBevel btn-modifica" data-id="@ware.MovementId" title="Modifica riga">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <!-- ELIMINA UTENTE -->
                        <button type="button"
                                class="btn btn-sm btn-outline-danger py-1 simpleBevel btn-elimina"
                                title="Cancella magazzino"
                                data-id="@ware.MovementId"
                                data-name="@ware.WarehouseName">

                            <i class="bi bi-trash"></i>
                        </button>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
