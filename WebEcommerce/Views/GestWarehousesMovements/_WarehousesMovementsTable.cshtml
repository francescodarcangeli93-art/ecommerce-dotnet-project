@model WebEcommerce.Models.WarehousesViewModel



<div class="table-responsive bevel">

    <input type="hidden" id="indirizzoDaEliminare" value="" />

    <table class="table table-striped table-hover table-bordered align-middle mb-0">
        <thead class="table-dark table-bordered">
            <tr>
                <th scope="col" class="text-center">Data</th>
                @if (Model.IsGlobal == true)
                {
                    <th scope="col" class="text-center">Nome Magazzino</th>
                }

                <th scope="col" class="text-center">Nome Prodotto</th>
                <th scope="col" class="text-center">Nome Fornitore</th>
                <th scope="col" class="text-center">Quantità</th>
                <th scope="col" class="text-center">Causale</th>
                <th scope="col" class="text-center">Note</th>
                <th class="text-center col-shrink-15">COMANDI</th>
            </tr>
        </thead>
        <tbody id="corpoTabella">
            @if (Model != null && (Model.TheWarehouseMovements != null && Model.TheWarehouseMovements.Count > 0))
            {
                foreach (var ware in Model.TheWarehouseMovements)
                {
                    <tr data-id="@ware.MovementId">
                        <td class="text-start">@ware.Date</td>
                        @if (Model.IsGlobal == true)
                        {
                            <td class="text-start wareName" title="vai al dettaglio magazzino"><a href="@Url.Action("Details", "GestWarehouses", new { id = ware.WarehouseId })">@ware.WarehouseName</a></td>
                        }
                        <td class="text-start">@ware.ProductName</td>
                        <td class="text-start">@ware.CompanyName</td>
                        <td class="text-center icon @(ware.quntityClass)">@ware.QuantityEdit</td>
                        <td class="text-start">@ware.Detail</td>
                        <td class="text-start">@ware.Notes</td>


                        <td class="text-ce px-4 spazio-comandi">
                            <button class="btn btn-sm btn-outline-info py-1 simpleBevel btn-dettagli"
                                    data-url="@Url.Action("Details", "GestWarehousesMovements")"
                                    data-id="@ware.MovementId" title="Visualizza Dettagli">
                                <i class="bi bi-search"></i>
                            </button>

                            <a class="btn btn-sm btn-outline-warning py-1 simpleBevel btn-modifica" data-id="@ware.MovementId" data-target="edit-modal" data-edit-url="@Url.Action("UpdateMovement", "GestWarehousesMovements")" title="Modifica riga">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <!-- ELIMINA UTENTE -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger py-1 simpleBevel btn-elimina"
                                    title="Cancella magazzino"
                                    data-id="@ware.MovementId"
                                    data-name="@ware.WarehouseName">

                                <i class="bi bi-trash"></i>
                            </button>
                        </td>

                    </tr>
                }


            }
            else
            {
                <tr><td><p>Nessun movimento trovato</p></td></tr>
            }
        </tbody>
    </table>
</div>

<!--========================================================================================================================================
    PAGINAZIONE
==========================================================================================================================================-->

<div class="d-flex justify-content-between align-items-center mt-3 px-3">
    <span class="text-muted small">
        Pagina @Model.CurrentPage di @Model.TotalPage (@Model.TotCount Movimenti totali)
    </span>

    <nav aria-label="Page navigation">
        @*  *@
        <ul class="pagination pagination-sm mb-0">

            <li class="page-item" @(Model.CurrentPage == 1 ? "disabled" : "")>
                <a class="page-link text-dark" href="#" data-page="@(Model.CurrentPage - 1)">
                    <i class="bi bi-chevron-left"></i> Precedente
                </a>
            </li>

            <li class="page-item" @(Model.CurrentPage == Model.TotalPage ? "disabled" : "")>
                <a class="page-link text-dark" href="#" data-page="@(Model.CurrentPage + 1)">
                    Successiva <i class="bi bi-chevron-right"></i>
                </a>
            </li>

        </ul>
    </nav>
</div>


<!--=====================================================================================================================================================
    MODALE DETTAGLIO MOVIMENTO
==========================================================================================================================================================-->

<div class="modal fade" id="modalDettaglioMovimento" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">

            <!-- HEADER -->
            <div class="modal-header bg-light border-0 pt-3 pb-2 px-4">
                <div>
                    <span class="badge bg-secondary fw-normal mb-1">ID Movimento #<span id="det-movement-id"></span></span>
                    <h5 class="modal-title fw-bold text-dark" id="modalDettaglioLabel">Dettaglio Movimento Magazzino</h5>
                </div>
                @*<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>*@
            </div>


            <!-- BODY -->
            <div class="modal-body p-4">

                <!-- Banner sintetico Quantità e Tipo -->
                <div class="p-3 mb-4 rounded-3 d-flex align-items-center justify-content-between  bg-success-subtle border border-success-subtle" id="banner-tipo">
                    <div>
                        <div class="small text-uppercase fw-semibold">Tipo Operazione</div>
                        <div class="fs-5 fw-bold" id="det-detail"></div>
                    </div>
                    <div class="text-end">
                        <div class="small text-uppercase fw-semibold">Quantità Movimentata</div>
                        <div class="fs-2 fw-bolder" id="det-quantity"></div>
                    </div>
                </div>

                <!-- Griglia Dati (2 Colonne) -->
                <div class="row g-3">

                    <!-- Data e Ora -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Data e Ora</div>
                            <div class="fw-semibold text-dark fs-6" id="det-date"></div>
                        </div>
                    </div>

                    <!-- Magazzino -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Magazzino</div>
                            <div class="fw-semibold text-dark fs-6">
                                <span id="det-warehouse-name"></span>
                                <span class="text-muted small">(ID: <span id="det-warehouse-id"></span>)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Prodotto -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Prodotto</div>
                            <div class="fw-semibold text-dark fs-6">
                                <span id="det-product-name"></span>
                                <span class="text-muted small">(ID: <span id="det-product-id"></span>)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Fornitore / Azienda -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Fornitore / Azienda</div>
                            <div class="fw-semibold text-dark fs-6" id="det-company-name"></div>
                        </div>
                    </div>

                    <!-- Causale -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Causale Movimento</div>
                            <div class="fw-semibold text-dark fs-6">
                                <span id="det-description"></span>
                                <span class="text-muted small d-block">ID Causale: <span id="det-reason-id"></span></span>
                            </div>
                        </div>
                    </div>

                    <!-- Dettaglio Operazione -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Dettaglio Operazione</div>
                            <div class="fw-semibold text-dark fs-6" id="det-detail-text"></div>
                        </div>
                    </div>

                    <!-- Note -->
                    <div class="col-12">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Note</div>
                            <div class="text-dark" id="det-notes"></div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer bg-light border-0 px-4 py-3">
                <button id="backToMovement" type="button" class="btn btn-dark px-4" data-bs-dismiss="modal">Chiudi</button>
            </div>

        </div>
    </div>
</div>

<!--=====================================================================================================================================================
    MODALE MODIFICA NOTE
==========================================================================================================================================================-->

<dialog id="edit-modal">

    <h2>Modifica le note</h2>

    <!-- input nascosto l'id viene memorizzato grazie alla click definito nel file globale ' -->
    <input class="global-modaledit-id" type="hidden" value="" />

    <div>
        <label for="editNote" class="form-label">Inserire Nota</label>
        <textarea id="editNote" class="form-control"></textarea>
    </div>


    <button class="btn-close-modal">Close</button>
    <button id="edit-movement" data-edit-url="@Url.Action("UpdateMovement", "GestWarehousesMovements")">Modifica</button>

</dialog>