@model WebEcommerce.Models.WarehousesViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}


<main class="container mt-4">
    <div class="title-conteiner">
        <h1>
            Gestione Movimenti Magazzini
        </h1>
    </div>

    <!--  FILTRI -->
    <div class="mb-4 p-4 bg-white card-animated card-detail">
        <h5 class="mb-4 fw-semibold text-dark">Ricerca Moviementi</h5>
        <div>
            <div class="card-body row g-3" id="filtriContainer">

                <div class="col-md-3">
                    <input type="Date" id="searchStartDate" name="StartDate" placeholder="Nome Categoria" class="form-control input-animated" />
                    <label class="temp-place" for="searchStartDate">Data inizio</label>
                </div>

                <div class="col-md-3">
                    <input type="Date" id="searchEndDate" name="EndDate" placeholder="Nome Categoria" class="form-control input-animated" />
                    <label class="temp-place" for="searchEndDate">data fine</label>
                </div>


                <div class="col-md-3">
                    <select name="WarehouseId" id="searchWarehouseId" class="form-select input-animated">
                        <option value="">--Selezionare il magazzino--</option>
                        @foreach (var warehouse in Model.sp_GetAllWareHouseList)
                        {
                            <option value="@(warehouse.Id)">@warehouse.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <input type="text" id="searchDescription" name="Description" placeholder="Cerca per Descrizione" class="form-control input-animated" />
                </div>



                <div class="col-md-3 d-flex align-items-center gap-2 justify-content-end">
                    <button type="button" id="btnPulisci" class="btn fw-semibold px-4 btn-animated bt-pulisci"><i class="bi-eraser"></i>  Pulisci</button>
                    <button type="button" id="btnCerca" class="btn fw-semibold px-4 btn-animated bt-cerca" data-search-url="@Url.Action("SearchProductCategoryPartial", "GestProductCategory")"><i class="bi bi-search me-1"></i> Cerca</button>
                </div>

            </div>
        </div>
    </div>

    @*TASTO AGGIUNGI*@
    <div class="d-flex justify-content-between align-items-end mb-3">
        <h3 class="m-0">Lista Magazzini</h3>

        <a id="btnAggiungi" class="btn fw-semibold px-4 btn-animated buttonAdd" data-bs-toggle="modal" data-bs-target="#modalNuovoMovimento">
            <i class="bi bi-box-seam"></i> Nuovo movimento
        </a>

    </div>


    <div id="tabellaContainer"
         data-partial-url="@Url.Action("SearchWarehousesMovementsPartial", "GestWarehousesMovements")">
        @Html.Partial("_WarehousesMovementsTable")
    </div>



</main>


<!--=====================================================================================================================================================
    MODALE AGGIUNGI MOVIMENTO
==========================================================================================================================================================-->


<div class="modal fade" id="modalNuovoMovimento" tabindex="-1" aria-labelledby="modalNuovoMovimentoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form id="formNuovoMovimento">

                <div class="modal-header">
                    <h5 class="modal-title" id="modalNuovoMovimentoLabel">Nuovo movimento di magazzino</h5>

                </div>

                <div class="modal-body">

                    <!-- Alert per errori restituiti dal backend (es. RAISERROR della SP) -->
                    <div id="alertErroreMovimento" class="alert alert-danger d-none" role="alert"></div>

                    <!-- CAUSALE -->
                    <div class="mb-3">
                        <label for="saveCausale" class="form-label">Causale <span class="text-danger">*</span></label>
                        <select id="saveCausale" name="MovementReasonId" class="form-select" required>
                            <option value="" selected>-- Seleziona una causale --</option>
                            @foreach (var causale in Model.TheMovementReasonList)
                            {
                                <option value="@(causale.Id)">@causale.Code @causale.MovementType</option>
                            }
                        </select>
                    </div>

                    <!-- PRODOTTO -->
                    <div class="mb-3">
                        <label for="saveProdotto" class="form-label">Prodotto <span class="text-danger">*</span></label>
                        <select id="saveProdotto" name="ProductId" class="form-select" required>
                            <option value="" selected disabled>-- Seleziona un prodotto --</option>
                            @foreach (var product in Model.TheProductsList)
                            {
                                <option value="@(product.Id)">@product.ProductName</option>
                            }
                        </select>
                    </div>

                    <!-- MAGAZZINO (partenza / unico) -->
                    <div id="magazzinoDestinazione" class="mb-3">
                        <label for="saveMagazzino" id="lblMagazzino" class="form-label">Magazzino di partenza <span class="text-danger">*</span></label>
                        <select id="saveMagazzino" name="WarehouseId" class="form-select" required>
                            <option value="" selected disabled>-- Seleziona un magazzino --</option>
                            @* Sezione Magazzini Spedizioni *@
                            <optgroup label="🚚 Magazzini Spedizioni">
                                @foreach (var wh in Model.sp_GetAllWareHouseList.Where(w => w.Type == "SHIPMENT"))
                                {
                                    <option value="@wh.Id">@wh.Name (@wh.City)</option>
                                }
                            </optgroup>

                            @* Sezione Altri Magazzini / Stock *@
                            <optgroup label="📦 Magazzini Stock / Centrali">
                                @foreach (var wh in Model.sp_GetAllWareHouseList.Where(w => w.Type != "SHIPMENT"))
                                {
                                    <option value="@wh.Id">@wh.Name (@wh.City)</option>
                                }
                            </optgroup>

                        </select>
                        <small id="hintGiacenza" class="form-text text-muted"></small>
                    </div>

                    <!-- MAGAZZINO DESTINAZIONE (solo per TRASF, nascosto di default) -->
                    <div class="mb-3" id="rowMagazzinoDestinazione">
                        <label for="saveMagazzinoDestinazione" class="form-label">Magazzino destinazione <span class="text-danger">*</span></label>
                        <select id="saveMagazzinoDestinazione" name="DestinationWarehouseId" class="form-select">
                            <option value="" selected disabled>-- Seleziona un magazzino --</option>
                            <optgroup label="🚚 Magazzini Spedizioni">
                                @foreach (var wh in Model.sp_GetAllWareHouseList.Where(w => w.Type == "SHIPMENT"))
                                {
                                    <option value="@wh.Id">@wh.Name (@wh.City)</option>
                                }
                            </optgroup>

                            @* Sezione Altri Magazzini / Stock *@
                            <optgroup label="📦 Magazzini Stock / Centrali">
                                @foreach (var wh in Model.sp_GetAllWareHouseList.Where(w => w.Type != "SHIPMENT"))
                                {
                                    <option value="@wh.Id">@wh.Name (@wh.City)</option>
                                }
                            </optgroup>

                        </select>
                    </div>

                    <!-- QUANTITA' -->
                    <div class="mb-3">
                        <label for="saveQuantita" class="form-label">Quantità <span class="text-danger">*</span></label>
                        <input type="number" id="saveQuantita" name="QtyToTransfer" class="form-control" min="1" step="1" required />
                    </div>

                </div>
                <div class="error-message-3">
                    <div id="resultMessageSaveMovement"></div>
                </div>
                <div class="modal-footer">

                    <button type="button" class="cmButton no-btn" data-bs-dismiss="modal">Annulla</button>
                    <button type="button" class="cmButton si-edit-btn" data-save-url="@Url.Action("SaveMovement","GestWarehousesMovements")" id="SalvaMovimento">Conferma</button>

                </div>
            </form>
        </div>
    </div>
</div>


<!--=====================================================================================================================================================
    MODALE DETTAGLIO MOVIMENTO
==========================================================================================================================================================-->

<div class="modal fade" id="modalDettaglioMovimento" tabindex="-1" aria-labelledby="modalDettaglioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">

            <!-- HEADER -->
            <div class="modal-header bg-light border-0 pt-3 pb-2 px-4">
                <div>
                    <span class="badge bg-secondary fw-normal mb-1">ID Movimento #<span id="det-movement-id"></span></span>
                    <h5 class="modal-title fw-bold text-dark" id="modalDettaglioLabel">Dettaglio Movimento Magazzino</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body p-4">

                <!-- Banner sintetico Quantità e Tipo -->
                <div class="p-3 mb-4 rounded-3 d-flex align-items-center justify-content-between bg-success-subtle text-success border border-success-subtle" id="banner-tipo">
                    <div>
                        <div class="small text-uppercase fw-semibold">Tipo Operazione</div>
                        <div class="fs-5 fw-bold" id="det-detail"></div>
                    </div>
                    <div class="text-end">
                        <div class="small text-uppercase fw-semibold">Quantità Movimentata</div>
                        <div class="fs-2 fw-bolder" id="det-quantity"></div>
                    </div>
                </div>

                <!-- Griglia Dati (2 Colonne) -->
                <div class="row g-3">

                    <!-- Data e Ora -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Data e Ora</div>
                            <div class="fw-semibold text-dark fs-6" id="det-date"></div>
                        </div>
                    </div>

                    <!-- Magazzino -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Magazzino</div>
                            <div class="fw-semibold text-dark fs-6">
                                <span id="det-warehouse-name"></span>
                                <span class="text-muted small">(ID: <span id="det-warehouse-id"></span>)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Prodotto -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Prodotto</div>
                            <div class="fw-semibold text-dark fs-6">
                                <span id="det-product-name"></span>
                                <span class="text-muted small">(ID: <span id="det-product-id"></span>)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Fornitore / Azienda -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Fornitore / Azienda</div>
                            <div class="fw-semibold text-dark fs-6" id="det-company-name"></div>
                        </div>
                    </div>

                    <!-- Causale -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Causale Movimento</div>
                            <div class="fw-semibold text-dark fs-6">
                                <span id="det-description"></span>
                                <span class="text-muted small d-block">ID Causale: <span id="det-reason-id"></span></span>
                            </div>
                        </div>
                    </div>

                    <!-- Dettaglio Operazione -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Dettaglio Operazione</div>
                            <div class="fw-semibold text-dark fs-6" id="det-detail-text"></div>
                        </div>
                    </div>

                    <!-- Note -->
                    <div class="col-12">
                        <div class="p-3 border rounded bg-light-subtle">
                            <div class="text-muted small fw-bold text-uppercase mb-1">Note</div>
                            <div class="text-dark" id="det-notes"></div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer bg-light border-0 px-4 py-3">
                <button type="button" class="btn btn-dark px-4" data-bs-dismiss="modal">Chiudi</button>
            </div>

        </div>
    </div>
</div>

@section scripts {
    <script>const searchMovements = '@Url.Action("SearchWarehousesMovementsPartial", "GestWarehousesMovements")'</script>
    <script src="@Url.Content("~/Scripts/js/WarehouseMovements.js")"></script>
}

