<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @*<title>@ViewBag.Title - My Ecommerce Application 1.0.0</title>*@
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    @Scripts.Render("~/bundles/modernizr")

    @RenderSection("styles", required: false)


</head>

<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark custom-navbar">
        <div class="container-fluid d-flex align-items-center custom-navbar-container">

            <a class="navbar-brand d-flex align-items-center m-0 p-0" href="/Home">
                <img src="~/Content/Image/LogoEcommerce.png" width="200" alt="Logo" class="img-fluid" />
            </a>

            <div class="collapse navbar-collapse ms-4" id="navbarNav">
                @if (Session["Role"] != null && Session["Role"].ToString().ToLower() != "customer")
                {
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white fw-medium" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Gestione
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark bg-dark border-0 shadow" aria-labelledby="navbarDropdown">
                                <li>
                                    <a class="dropdown-item text-white py-2" href="@Url.Action("GestioneUtenti", "Gestutenti")">
                                        <i class="bi bi-people-fill me-2 text-secondary"></i> Gest-Utenti
                                    </a>
                                    <a class="dropdown-item text-white py-2" href="@Url.Action("Index", "GestSupplier")">
                                        <i class="bi bi-truck me-2 me-2 text-secondary"></i> Fornitori
                                    </a>
                                    <a class="dropdown-item text-white py-2">
                                        <i class="bi-tag-fill me-2 text-secondary"></i> Listino-Prezzi
                                    </a>
                                    <a class="dropdown-item text-white py-2">
                                        <i class="bi-house-door-fill  me-2 text-secondary"></i> Magazzini
                                    </a>
                                    <a class="dropdown-item text-white py-2">
                                        <i class="bi-box-fill  me-2 text-secondary"></i> Prodotti
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul> 
                }
            </div>



            @if (Session["User"] != null)
            {
                <div class="text-white d-flex align-items-center gap-3">
                   <i  class="bi bi-person-fill user" ></i> <span> @Session["User"] (@Session["Role"])</span>

                    <a href="/Home/Logout"  class="logout">Logout</a>
                
                </div>
            }

        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My Ecommerce Application 1.0.0</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
  @*  @Scripts.Render("~/bundles/bootstrap")*@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)

</body>
</html>