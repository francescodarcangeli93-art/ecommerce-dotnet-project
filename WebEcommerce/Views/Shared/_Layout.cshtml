<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @*<title>@ViewBag.Title - My Ecommerce Application 1.0.0</title>*@
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    @Scripts.Render("~/bundles/modernizr")

    @RenderSection("styles", required: false)



</head>

<body>
    <nav class="navbar navbar-expand-sm navbar-dark custom-navbar">
        <div class="container-fluid d-flex align-items-center custom-navbar-container">

            <a class="navbar-brand d-flex align-items-center m-0 p-0" href="/Home">
                <img src="~/Content/Image/LogoEcommerce.png" width="200" alt="Logo" class="img-fluid" />
            </a>

            <div class="collapse navbar-collapse ms-4" id="navbarNav">
                @if (Session["Role"] != null && Session["Role"].ToString().ToLower() != "customer")
                {
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white fw-medium title-nav" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Gestione
                            </a>

                            <ul class="dropdown-menu dropdown-menu-dark custom-navbar-tool border-0 shadow" aria-labelledby="navbarDropdown">
                                <li>
                                    <a class="dropdown-item  py-2" href="@Url.Action("GestioneUtenti", "Gestutenti")">
                                        <i class="bi bi-people-fill me-2 text-secondary"></i> Gest-Utenti
                                    </a>
                                    <a class="dropdown-item  py-2" href="@Url.Action("Index", "GestSupplier")">
                                        <i class="bi bi-truck me-2 text-secondary"></i> Fornitori
                                    </a>
                                    <a class="dropdown-item  py-2" href="@Url.Action("Index", "GestWarehouses")">
                                        <i class="bi-house-door-fill me-2 text-secondary"></i> Magazzini
                                    </a>
                                    <a class="dropdown-item  py-2" href="@Url.Action("Index", "GestPriceList")">
                                        <i class="bi-tag-fill me-2 text-secondary"></i> Listino-Prezzi
                                    </a>
                                    <a class="dropdown-item  py-2"  href="@Url.Action("Index", "GestProductCategory")">
                                        <i class="bi-box-fill me-2 text-secondary"></i>Categorie Prodotti
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                }
            </div>

            @*href="/Home/Logout"*@

            @if (Session["User"] != null)
            {  
                <div class="text-white d-flex align-items-center gap-3">
                    <i class="bi bi-person-fill user"></i> <span> @Session["User"] (@Session["Role"])</span>

                    @*<p class="logout"><i id="logout" class="bi bi-box-arrow-up-left"></i> Logout</p>*@
                    <button id="logout" class="log-out-btn">
                         <i class="icon-logout-simple"></i>
                        Logout
                    </button>

                </div>
            }

        </div>
    </nav>


    <!-- Modale Elimina 2 -->
    <div class="myModal-overlay" id="logOut">
        <div class="personal-card">
            <div class="body">

                <!--risultato messaggio errore o successo-->


                <div class="cont-icon">
                    <span class="icona-logout"></span>
                </div>


                <h3>Conferma Logout</h3>
                <p>Sei sicuro di voler uscire dal tuo account?</p>
            </div>
            <div class="buttons">
                <button class="no-btn">Annulla</button>
                <button id="si-btn" class="slog-btn" data-url="@Url.Action("Logout", "Home")">Esci</button>
            </div>
        </div>
    </div>




    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My Ecommerce Application 1.0.0</p>
            @Scripts.Render("~/bundles/jquery")
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @*  @Scripts.Render("~/bundles/bootstrap")*@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

        <script src="@Url.Content("~/Scripts/js/Layout.js")"></script>
    

    @RenderSection("scripts", required: false)

</body>
</html>