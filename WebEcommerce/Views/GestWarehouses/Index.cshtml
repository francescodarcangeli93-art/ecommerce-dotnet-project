@model WebEcommerce.Models.WarehousesViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}
<main class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="fw-bold text-black text-center w-100 titolo-animated">
            Gestione Magazzini
        </h1>
    </div>

    <!--  FILTRI -->
    <div class="mb-4 p-4 bg-white card-animated card-detail">
        <h5 class="mb-4 fw-semibold text-dark">Ricerca Magazzini</h5>
        <div>
            <div class="card-body row g-3" id="filtriContainer">

                <div class="col-md-3">
                    <select name="Type" id="searchType" class="form-select input-animated">
                        <option value="">--Selezionare il Tipo--</option>
                        <option value="SHIPMENT">SHIPMENT</option>
                        <option value="STOCK">STOCK</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <input type="text" id="searchNome" name="Name" placeholder="Nome Magazzino" class="form-control input-animated" />
                </div>

                <div class="col-md-3">
                    <input type="text" id="searchCitta" name="City" placeholder="Città" class="form-control input-animated" />
                </div>

                <div class="col-md-3">
                    <input type="text" id="searchPostalCode" name="PostalCode" placeholder="CAP" class="form-control input-animated" />
                </div>

                <div class="col-md-3">
                    <select name="IsActive" id="searchIsActive" class="form-select input-animated">
                        <option value="">--Selezionare lo Stato--</option>
                        <option value="true">Attivo</option>
                        <option value="false">Non Attivo</option>
                    </select>
                </div>

                <div class="col-md-9 d-flex align-items-center gap-2 justify-content-end">
                    <button type="button" id="btnPulisci" class="btn fw-semibold px-4 btn-animated bt-pulisci"><i class="bi-eraser"></i>  Pulisci</button>
                    <button type="button" id="btnCerca" class="btn fw-semibold px-4 btn-animated bt-cerca"><i class="bi bi-search me-1"></i> Cerca</button>
                </div>

            </div>
        </div>
    </div>


    @*TASTO AGGIUNGI*@
    <div class="d-flex justify-content-between align-items-end mb-3">
        <h3 class="m-0">Lista Magazzini</h3>

        <a id="btnAggiungi" class="btn fw-semibold px-4 btn-animated buttonAdd" data-bs-toggle="modal" data-bs-target="#aggiungi">
            <i class="bi bi-box-seam"></i> Aggiungi
        </a>
    </div>

    <div id="tabellaContainer">
        @Html.Partial("_WarehousesTable", Model)
    </div>
</main>


<!--MODALE AGGIUNGI-->
<div class="modal fade" id="aggiungi" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Aggiungi Magazzino</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="mb-4 p-4 bg-white card-animated card-detail">
                    <div>
                        <div class="card-body row g-3">

                            <form id="warehouseForm">

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="mdlTipo">Tipo Magazzino</label>
                                        <select name="Type" id="mdlTipo" class="form-select" required>
                                            <option value="">--Selezionare un tipo--</option>
                                            <option value="SHIPMENT">Shipment</option>
                                            <option value="STOCK" selected>Stock</option>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label for="mdlNome">Nome</label>
                                        <input type="text" id="mdlNome" name="Name" placeholder="Nome Referente" class="form-control input-animated" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="mdlIndirizzo">Indirizzo</label>
                                        <input type="text" id="mdlIndirizzo" name="Address" placeholder="Indirizzo" class="form-control input-animated"
                                               maxlength="100"
                                               pattern="^[A-Za-zÀ-ÿ\s]+\s\d+$"
                                               title="Inserisci un indirizzo valido (es. Via Roma 12)"
                                               required />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="mdlCAP">CAP</label>
                                        <input type="text" id="mdlCAP" name="PostalCode" placeholder="Cap" class="form-control input-animated"
                                               pattern="[0-9]{5}"
                                               maxlength="5"
                                               required
                                               title="Il CAP deve essere composto da esattamente 5 cifre numeriche." />
                                    </div>

                                    <div class="mb-3">
                                        <label for="mdlCitta">Città</label>
                                        <input type="text" id="mdlCitta" placeholder="es: Roma" name="City" class="form-control input-animated" required />
                                    </div>

                                    <div class="mb-3">
                                        <label>Stato Magazzino</label><br />
                                        <label class="me-2">
                                            <input type="radio" id="mdlTrue" name="IsActive" value="true" checked />
                                            <span>Attivo</span>
                                        </label>
                                        <label>
                                            <input type="radio" id="mdlFalse" name="IsActive" value="false" />
                                            <span>Non Attivo</span>
                                        </label>
                                    </div>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>

                <div id="resultMessage" class="mt-2 text-center"></div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Indietro</button>
                <button type="button" id="btnSalva" class="btn btn-primary">Salva</button>
            </div>

        </div>
    </div>
</div>

<!--MODALE ELIMINA-->
<div class="modal fade" id="modalElimina" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Elimina</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Sicuro di voler eliminare il fornitore <strong id="nomeFornitore"></strong>?
                <div id="resultMessageElimina" class="mt-2"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="confermaElimina" data-url="@Url.Action("Delete","GestWarehouses")" class="btn btn-danger">Elimina</button>
            </div>
        </div>
    </div>
</div>



<!-- MODALE MODIFICA Magazzino-->
<div class="modal fade" id="modalEdit" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="mb-4 p-4 bg-white card-animated card-detail">
                <div>
                    <div class="card-body row g-3">
                        <input type="hidden" id="editId" />

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editTipo">Tipo Magazzino</label>
                                <select name="Type" id="editTipo" class="form-select" required>
                                    <option value="">--Selezionare un tipo--</option>
                                    <option value="SHIPMENT">Shipment</option>
                                    <option value="STOCK" selected>Stock</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="editNome">Nome</label>
                                <input type="text" id="editNome" name="Name" placeholder="Nome Referente" class="form-control input-animated" required />
                            </div>

                            <div class="mb-3">
                                <label for="editIndirizzo">Indirizzo</label>
                                <input type="text" id="editIndirizzo" name="Address" placeholder="Indirizzo" class="form-control input-animated"
                                       maxlength="100"
                                       pattern="^[A-Za-zÀ-ÿ\s]+\s\d+$"
                                       title="Inserisci un indirizzo valido (es. Via Roma 12)"
                                       required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editCAP">CAP</label>
                                <input type="text" id="editCAP" name="PostalCode" placeholder="Cap" class="form-control input-animated"
                                       pattern="[0-9]{5}"
                                       maxlength="5"
                                       required
                                       title="Il CAP deve essere composto da esattamente 5 cifre numeriche." />
                            </div>

                            <div class="mb-3">
                                <label for="editCitta">Città</label>
                                <input type="text" id="editCitta" placeholder="es: Roma" name="City" class="form-control input-animated" required />
                            </div>

                            <div class="mb-3">
                                <label>Stato Magazzino</label><br />
                                <label class="me-2">
                                    <input type="radio" id="editTrue" name="editIsActive" value="true" checked />
                                    <span>Attivo</span>
                                </label>
                                <label>
                                    <input type="radio" id="editFalse" name="editIsActive" value="false" />
                                    <span>Non Attivo</span>
                                </label>
                            </div>
                        </div>


                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" id="btnEditModifica" class="btn btn-success">Modifica</button>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script src="@Url.Content("~/Scripts/js/GestioneWarehouse.js")"></script>
}