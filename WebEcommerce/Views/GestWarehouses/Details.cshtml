@model WebEcommerce.Models.WarehousesViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string badgeStatoClass = Model.TheWarehouse.IsActive ? "badge-attivo" : "badge-non-attivo";
    string testoStato = Model.TheWarehouse.IsActive ? "ATTIVO" : "NON ATTIVO";
    string testoTipo = Model.TheWarehouse.Type == "SHIPMENT" ? "Spedizione" : "Stock";
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
}

<div class="container mt-4 mb-5">

    <div class="header-magazzino">
        <div>

            <div class="text-muted magazziniDimensioni"><a href="@Url.Action("Index", "GestWarehouses")">Magazzini</a> / Gestione</div>
            <h3 class="mb-1">@Model.TheWarehouse.Name</h3>
            <div class="text-muted" style="font-size: 13px;">
                @Model.TheWarehouse.Address &middot; @Model.TheWarehouse.City &middot; @Model.TheWarehouse.PostalCode
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge-tipo">@testoTipo</span>
            <span class="badgeCustom @badgeStatoClass">@testoStato</span>
        </div>
    </div>

    <ul class="nav nav-tabs nav-tabs-magazzino mb-3" id="tabMagazzino" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-giacenze-btn" data-bs-toggle="tab" data-bs-target="#tab-giacenze" type="button" role="tab">
                <i class="bi bi-box-seam"></i> Giacenze
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-movimenti-btn" data-bs-toggle="tab" data-bs-target="#tab-movimenti" type="button" role="tab">
                <i class="bi bi-clock-history"></i> Cronologia Movimenti
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-impostazioni-btn" data-bs-toggle="tab" data-bs-target="#tab-impostazioni" type="button" role="tab">
                <i class="bi bi-gear"></i> Dettagli Anagrafici
            </button>
        </li>
    </ul>

    <div class="tab-content" id="tabMagazzinoContent">

        <!--=========================================================================================
              TAB GIACENZE
        =============================================================================================-->

        <div class="tab-pane fade show active" id="tab-giacenze" role="tabpanel">

            <div class="d-flex justify-content-between mb-3 gap-2">
                <!-- Ricerca Prodotto -->
                <input type="text" id="ricercaProdotto" class="form-control" style="max-width: 350px;" placeholder="Cerca prodotto per nome o codice" />


                <!--  BOTTONE AGGIUNGI PRODOTTO -->
                <button id="btn-addCarico" type="button" class="btn btn-animated btn-giallo"
                        data-bs-toggle="modal" data-bs-target="#modalCaricaProdotto">
                    <i class="bi bi-plus-lg"></i> Aggiungi Prodotto (Carico Merce)
                </button>
            </div>

            <!-- PARTIAL VIEW TABELLA GIACENZE -->
            <div id="contenitoreTabellaGiacenze">
                @Html.Action("GetTabellaGiacenze", "GestWarehouses", new { Warehouseid = Model.TheWarehouse.Id })
            </div>


        </div>

        <!-- TAB 2: CRONOLOGIA MOVIMENTI -->
        <div class="tab-pane fade" id="tab-movimenti" role="tabpanel">

            <div class="row g-2 mb-3">
                <div class="col-md-3">

                    <input type="date" class="form-control" id="filtroDataDa" placeholder="Datada" />
                    <label class="temp-place  form-label" style="font-size: 12px; color: #6c757d;">Dal</label>
                </div>
                <div class="col-md-3">

                    <input type="date" class="form-control" id="filtroDataA" placeholder="DataA" />
                    <label class="temp-place form-label" style="font-size: 12px; color: #6c757d;">Al</label>
                </div>

                <div class="col-md-3">
                    <select class="form-select" id="filtroTipoMovimento">
                        <option value="">Tutti i tipi</option>
                        <option value="IN">Ingresso</option>
                        <option value="OUT">Uscita</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" id="filtroProdottoMovimento" placeholder="Cerca prodotto" />
                </div>
            </div>

            <table class="table tabella-magazzino" id="tabellaMovimenti">
                <thead>
                    <tr>
                        <th class="text-center">Data</th>
                        <th class="text-center">Causale</th>
                        <th class="text-center"">Prodotto</th>
                        <th class="text-center">Quantità</th>
                        <th class="text-center">Origine/Destinazione</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Da Fare il loop delle rige -->
                    @foreach (var magazzino in Model.TheWarehouseMovementsList)
                    {
                        <tr>
                            <td>@magazzino.LastUpdate</td>
                            <td class="text-center"><span class="causale causale-badge @magazzino.ColorClass">@magazzino.Code</span></td>
                            <td>@magazzino.ProductName</td>
                            @if (magazzino.MovementType == "+")
                            {
                                <td class="text-center  icon icon-green">+@magazzino.QuantitaMovimento</td>
                            }
                            else
                            {
                                <td class="text-center  icon icon-red">-@magazzino.QuantitaMovimento</td>
                            }

                            <td class="text-center spedizione">@(magazzino.SupplierId != null ? "fornitore" : "Magazzino Spedizioni")</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

        <!-- TAB 3: IMPOSTAZIONI ANAGRAFICHE -->
        <div class="tab-pane fade" id="tab-impostazioni" role="tabpanel">

            <form id="formImpostazioni">
                <div class="card p-3 mb-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nome</label>
                            <input type="text" class="form-control" id="inputNome" value="@Model.TheWarehouse.Name" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tipo</label>
                            <select class="form-select" id="inputTipo" disabled>
                                <option value="STOCK" selected="@(Model.TheWarehouse.Type == "STOCK")">Stock</option>
                                <option value="SHIPMENT" selected="@(Model.TheWarehouse.Type == "SHIPMENT")">Spedizione</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Indirizzo</label>
                            <input type="text" class="form-control" id="inputIndirizzo" value="@Model.TheWarehouse.Address" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Città</label>
                            <input type="text" class="form-control" id="inputCitta" value="@Model.TheWarehouse.City" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">CAP</label>
                            <input type="text" class="form-control" id="inputCap" value="@Model.TheWarehouse.PostalCode" disabled />
                        </div>
                        <div class="col-md-12 form-check mt-2">
                            <input type="checkbox" class="form-check-input" id="inputIsActive" checked="@Model.TheWarehouse.IsActive" disabled />
                            <label class="form-check-label" for="inputIsActive">Magazzino attivo</label>
                        </div>
                    </div>

                    @*<div class="text-muted mt-2" style="font-size: 12px;">
                            <i class="bi bi-lock"></i> Il tipo non è modificabile se il magazzino contiene prodotti o movimenti registrati.
                        </div>*@


                </div>
            </form>

            <div class="danger-zone">
                <div>
                    <div class="fw-semibold">Elimina Magazzino</div>
                    <div class="text-muted" style="font-size: 13px;">Possibile solo se non ci sono prodotti o movimenti collegati.</div>
                </div>
                <button type="button" class="btn btn-outline-danger rounded-pill" id="btnEliminaMagazzino">
                    <i class="bi bi-trash"></i> Elimina
                </button>
            </div>
        </div>

    </div>
</div>

<!--=============================================================================================================================================
    MODAL: AGGIUNGI UN NUOVO  PRODOTTO
==================================================================================================================================================-->

<div class="modal fade" id="modalCaricaProdotto" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuovo Prodotto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

            </div>
            <div class="modal-body">

                <input type="hidden" id="saveMagazzino" name="WarehouseId" value="@Model.TheWarehouse.Id" />

                <!-- CAUSALE -->
                <div class="mb-3">
                    <label for="saveCausale" class="form-label">Causale <span class="text-danger">*</span></label>
                    <select id="saveCausale" name="MovementReasonId" class="form-select" required>
                        <option value="" disabled>-- Seleziona una causale --</option>
                        @foreach (var causale in Model.TheMovementReasonList.Where(x => x.MovementType == "+"))
                        {
                            <option value="@(causale.Id)">@causale.Code @causale.MovementType</option>
                        }
                    </select>
                </div>

                <!-- PRODOTTO -->
                <div class="mb-3">
                    <label for="saveProdotto" class="form-label">Prodotto <span class="text-danger">*</span></label>
                    <select id="saveProdotto" name="ProductId" class="form-select" required>
                        <option value="" selected disabled>-- Seleziona un prodotto --</option>
                        @foreach (var product in Model.TheProductsNotInTheWarouseList)
                        {
                            <option value="@(product.Id)">@product.ProductName</option>
                        }
                    </select>
                </div>

                <!-- QUANTITA' -->
                <div class="mb-3">
                    <label for="saveQuantita" class="form-label">Quantità <span class="text-danger">*</span></label>
                    <input type="number" id="saveQuantita" name="QtyToTransfer" class="form-control" min="1" step="1" required />
                </div>

                <div class="message-contener">
                    <span class="message"></span>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-giallo" data-carico-url="@Url.Action("CaricoProdotti","GestWarehouses")" id="btnConfermaCarico">Conferma Carico</button>
            </div>
        </div>
    </div>
</div>


<!--=============================================================================================================================================
    MODAL: Scarica/Rettifica Prodotto
==================================================================================================================================================-->
<div class="modal fade" id="modalScaricoProdotto" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Scarica / Rettifica Prodotto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="bg-light rounded p-2 mb-3">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Prodotto</span>
                        <span class="fw-semibold" id="scaricoProdottoNome"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Quantità attuale</span>
                        <span class="fw-semibold" id="scaricoQuantitaAttuale"></span>
                    </div>


                </div>

              
                <input type="hidden" id="removeMagazzino" name="WarehouseId" value="@Model.TheWarehouse.Id" />

                <!-- CAUSALE -->
                <div class="mb-3">
                    <label for="removeCausale" class="form-label">Causale <span class="text-danger">*</span></label>
                    <select id="removeCausale" name="MovementReasonId" class="form-select" required>
                        <option value="" disabled>-- Seleziona una causale --</option>
                        @foreach (var causale in Model.TheMovementReasonList.Where(x => x.MovementType == "-"))
                        {
                            <option value="@(causale.Id)" @(causale.Id == 3 ? "selected" : "")>@causale.Code @causale.MovementType</option>
                        }
                    </select>
                </div>

                <!-- QUANTITA' -->
                <div class="mb-3">
                    <label for="removeQuantita" class="form-label">Quantità <span class="text-danger">*</span></label>
                    <input type="number" id="removeQuantita" name="QtyToTransfer" class="form-control" min="1" step="1" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Note (opzionale)</label>
                    <textarea class="form-control" id="inputNoteScarico" rows="2"
                              placeholder="Aggiungi un dettaglio sul motivo dello scarico"></textarea>
                </div>

            </div>

            <div class="message-contener">
                <span class="message"></span>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-outline-danger" data-scarico-url="@Url.Action("CaricoProdotti","GestWarehouses")" id="btnConfermaScarico">Conferma Scarico</button>
            </div>
        </div>
    </div>
</div>

<!--=============================================================================================================================================
    MODAL: CARICO SINGOLO PRODOTTO
==================================================================================================================================================-->

<div class="modal fade" id="modalCaricoSingoloProdotto" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Carica Nuovo Prodotto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

            </div>
            <div class="modal-body">
                <div class="bg-light rounded p-2 mb-3">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Prodotto</span>
                        <span class="fw-semibold" id="singCaricoProdottoNome"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Quantità attuale</span>
                        <span class="fw-semibold" id="singQuantitaAttuale"></span>
                    </div>


                </div>

              
                <input type="hidden" id="addSingleMagazzino" name="WarehouseId" value="@Model.TheWarehouse.Id" />

                <!-- CAUSALE -->
                <div class="mb-3">
                    <label for="addSingleCausale" class="form-label">Causale <span class="text-danger">*</span></label>
                    <select id="addSingleCausale" name="MovementReasonId" class="form-select" required>
                        <option value="" disabled>-- Seleziona una causale --</option>
                        @foreach (var causale in Model.TheMovementReasonList.Where(x => x.MovementType == "+"))
                        {
                            <option value="@(causale.Id)">@causale.Code @causale.MovementType</option>
                        }
                    </select>
                </div>

                <!-- QUANTITA' -->
                <div class="mb-3">
                    <label for="addSingleQuantita" class="form-label">Quantità <span class="text-danger">*</span></label>
                    <input type="number" id="addSingleQuantita" name="QtyToTransfer" class="form-control" min="1" step="1" required />
                </div>

                <div class="message-contener">
                    <span class="message"></span>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-giallo" data-carico-url="@Url.Action("CaricoProdotti","GestWarehouses")" id="btnConfermaSingoloCarico">Conferma Carico</button>
            </div>
        </div>
    </div>
</div>



@section scripts {
    <script src="@Url.Content("~/Scripts/js/DettaglioWarehouse.js")"></script>
}


